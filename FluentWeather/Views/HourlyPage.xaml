<Page
    x:Class="FluentWeather.Views.HourlyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <!-- Local build: the 10-Day Hourly page. MainPage shows it over its content, below the title bar,
         in the same frame as the Full History page. It lists every hour of the hourly forecast that
         the app already loads, about 240 hours. The chart shows all hours. The chart picker chooses
         what the chart shows. List shows the main values of each hour, and a click on a row opens
         the other values. Table shows every value in its own column. The back button and Esc close
         the page. -->

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="16,12,16,10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2B2B2D" Offset="0" />
                <GradientStop Color="#2B3547" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="190" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The back button on the left, the title in the middle of the page. -->
        <Grid>
            <Button x:Name="BackButton"
                    x:Uid="HourlyPageBackButton"
                    HorizontalAlignment="Left"
                    Padding="10,5,12,5"
                    Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock x:Uid="HourlyPageBackText" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Uid="HourlyPageTitle" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Location, List or Table, and where the data comes from. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,8">
                <ComboBox x:Name="LocationCombo" MinWidth="230" FontSize="13"
                          SelectionChanged="Location_Changed" />
                <controls1:Segmented x:Name="ViewSegmented" SelectedIndex="0" FontSize="13"
                                     SelectionChanged="View_Changed">
                    <controls1:SegmentedItem x:Uid="HourlyPageViewList" />
                    <controls1:SegmentedItem x:Uid="HourlyPageViewTable" />
                </controls1:Segmented>
                <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="False"
                              VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- The chart picker. -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <controls1:Segmented x:Name="ChartSegmented" SelectedIndex="0" FontSize="13"
                                     SelectionChanged="Chart_Changed">
                    <controls1:SegmentedItem x:Uid="HourlyPageChartOverview" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartTemperature" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartFeelsLike" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartPrecip" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartWind" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartGusts" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartHumidity" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartUv" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartClouds" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartVisibility" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartDewPoint" />
                    <controls1:SegmentedItem x:Uid="HourlyPageChartPressure" />
                </controls1:Segmented>
            </StackPanel>
        </ScrollViewer>

        <!-- The chart of all hours. A click scrolls the list to that hour. -->
        <Border Grid.Row="3" Background="#343A4C" BorderBrush="#50586E" BorderThickness="1" CornerRadius="8">
            <Grid Margin="12,8,12,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChartTitle" FontSize="13" Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="LegendPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,4,0,0" Background="Transparent"
                        SizeChanged="ChartCanvas_SizeChanged"
                        PointerMoved="ChartCanvas_PointerMoved"
                        PointerExited="ChartCanvas_PointerExited"
                        Tapped="ChartCanvas_Tapped" />
                <TextBlock x:Name="ChartEmptyText" Grid.Row="1" FontSize="13" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <!-- The list or the table. It keeps its full width. In a narrow window it scrolls sideways. -->
        <ScrollViewer x:Name="TableScroll"
                      Grid.Row="4"
                      Margin="0,10,0,0"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      SizeChanged="TableScroll_SizeChanged">
            <Border Background="#343A4C" BorderBrush="#50586E" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="TableGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="TableHeader" Padding="12,8,12,6" BorderBrush="#50586E" BorderThickness="0,0,0,1" />
                    <ListView x:Name="HoursList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              Padding="4,2,4,2"
                              ItemClick="HoursList_ItemClick"
                              ContainerContentChanging="HoursList_ContainerContentChanging">
                        <!-- Each row is filled when it scrolls into view. See HoursList_ContainerContentChanging. -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Padding" Value="8,0,8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </ScrollViewer>

        <TextBlock x:Uid="HourlyPageCredit" Grid.Row="5" FontSize="10.5" Opacity="0.7" Margin="0,8,0,0"
                   TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
