<Page
    x:Class="FluentWeather.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    RequestedTheme="Dark">

    <!-- Local build: the Full History page. MainPage shows it over its content, below the title bar.
         One saved location and one year. Month and Year fit the chart to a month or the whole year.
         The mouse wheel zooms, and dragging, Shift+wheel or the scroll bar below the chart scroll it.
         A short view shows every hour. A chart picker chooses the chart. The table lists every field
         of the part in view. The back button and Esc close the page. Esc first undoes a zoom.
         The data comes from HistoryService. -->

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style x:Key="HistoryCellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HistoryHeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HistoryCellStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,16,10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2B2B2D" Offset="0" />
                <GradientStop Color="#2B3547" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="200" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The back button on the left, the title in the middle of the page. -->
        <Grid>
            <Button x:Name="BackButton"
                    x:Uid="HistoryBackButton"
                    HorizontalAlignment="Left"
                    Padding="10,5,12,5"
                    Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock x:Uid="HistoryBackText" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock x:Uid="HistoryTitle" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Location, year, month and Month or Year. -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,8">
                <ComboBox x:Name="LocationCombo" MinWidth="230" FontSize="13"
                          SelectionChanged="Reload_Changed" />
                <ComboBox x:Name="YearCombo" MinWidth="110" FontSize="13"
                          SelectionChanged="Reload_Changed" />
                <ComboBox x:Name="MonthCombo" MinWidth="130" FontSize="13"
                          SelectionChanged="Month_Changed" />
                <controls1:Segmented x:Name="RangeSegmented" SelectedIndex="0" FontSize="13"
                                     SelectionChanged="Range_Changed">
                    <controls1:SegmentedItem x:Uid="HistoryRangeMonth" />
                    <controls1:SegmentedItem x:Uid="HistoryRangeYear" />
                </controls1:Segmented>
                <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="False"
                              VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>

        <!-- The chart picker. -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,12">
                <controls1:Segmented x:Name="ChartSegmented" SelectedIndex="0" FontSize="13"
                                     SelectionChanged="Chart_Changed">
                    <controls1:SegmentedItem x:Uid="HistoryChartTemperature" />
                    <controls1:SegmentedItem x:Uid="HistoryChartWind" />
                    <controls1:SegmentedItem x:Uid="HistoryChartPrecip" />
                    <controls1:SegmentedItem x:Uid="HistoryChartAir" />
                    <controls1:SegmentedItem x:Uid="HistoryChartHumidity" />
                    <controls1:SegmentedItem x:Uid="HistoryChartPressure" />
                    <controls1:SegmentedItem x:Uid="HistoryChartClouds" />
                </controls1:Segmented>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="#343A4C" BorderBrush="#50586E" BorderThickness="1" CornerRadius="8">
            <Grid Margin="12,8,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The title, the legend, and the zoom buttons. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ChartTitle" FontSize="13" Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="LegendPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomHint" x:Uid="HistoryZoomHint" FontSize="11" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button x:Uid="HistoryZoomOut" Padding="9,5,9,5" Click="ZoomOut_Click">
                            <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE738;" FontSize="12" />
                        </Button>
                        <Button x:Uid="HistoryZoomIn" Padding="9,5,9,5" Click="ZoomIn_Click">
                            <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE710;" FontSize="12" />
                        </Button>
                        <Button x:Uid="HistoryZoomFit" Padding="10,3,10,4" FontSize="12" Click="ZoomFit_Click" />
                    </StackPanel>
                </Grid>
                <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,6,0,0" Background="Transparent"
                        SizeChanged="ChartCanvas_SizeChanged"
                        PointerWheelChanged="ChartCanvas_PointerWheelChanged"
                        PointerPressed="ChartCanvas_PointerPressed"
                        PointerMoved="ChartCanvas_PointerMoved"
                        PointerReleased="ChartCanvas_PointerReleased"
                        PointerCaptureLost="ChartCanvas_PointerCaptureLost"
                        PointerExited="ChartCanvas_PointerExited"
                        Tapped="ChartCanvas_Tapped" />
                <TextBlock x:Name="ChartEmptyText" Grid.Row="1" FontSize="13" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           IsHitTestVisible="False" />
                <!-- The scroll bar: where the view is in the year. Drag it, or click the track. -->
                <Canvas x:Name="ScrollCanvas" Grid.Row="2" Height="12" Margin="0,4,0,0" Background="Transparent"
                        PointerPressed="ScrollCanvas_PointerPressed"
                        PointerMoved="ScrollCanvas_PointerMoved"
                        PointerReleased="ScrollCanvas_PointerReleased"
                        PointerCaptureLost="ScrollCanvas_PointerCaptureLost" />
            </Grid>
        </Border>

        <!-- The table keeps its full width. In a narrow window it scrolls sideways. -->
        <ScrollViewer x:Name="TableScroll"
                      Grid.Row="4"
                      Margin="0,10,0,0"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      SizeChanged="TableScroll_SizeChanged">
            <Border Background="#343A4C" BorderBrush="#50586E" BorderThickness="1" CornerRadius="8">
                <Grid x:Name="TableGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="TableHeader" Padding="12,8,12,6" BorderBrush="#50586E" BorderThickness="0,0,0,1" />
                    <ListView x:Name="TableList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                              Padding="4,2,4,2" ContainerContentChanging="TableList_ContainerContentChanging">
                        <!-- Each row is filled when it scrolls into view. See TableList_ContainerContentChanging. -->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Padding" Value="8,0,8,0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>
        </ScrollViewer>

        <TextBlock Grid.Row="5" x:Uid="HistoryCredit" FontSize="10.5" Opacity="0.7" Margin="0,8,0,0"
                   TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
