<Page
    x:Class="FluentWeather.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:media2="using:Microsoft.UI.Xaml.Media"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FluentWeather.Views"
    xmlns:controls="using:FluentWeather.Controls"
    xmlns:models="using:FluentWeather.Models"
    xmlns:adapters="using:FluentWeather.Adapters"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:FluentWeather.Helpers"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">
    <!--xmlns:media="using:Microsoft.Toolkit.Uwp.UI.Media"-->

    <Page.Resources>
        <media2:AcrylicBrush x:Key="MyAcrylicBrush"
                             BackgroundSource="Backdrop"
                             TintColor="#FCFCFC"
                             TintOpacity="0"
                             TintLuminosityOpacity="0"
                             FallbackColor="#1DFFFFFF"
                             d:DataContext="{d:DesignInstance Type=views:MainPage, IsDesignTimeCreatable=True}"
                             AlwaysUseFallback="{x:Bind AcrylicEffectsService.UseFallback, Mode=OneWay}" />

        <media2:AcrylicBrush x:Key="MyAcrylicBrushLine"
                             BackgroundSource="Backdrop"
                             TintColor="#FCFCFC"
                             TintOpacity="0"
                             TintLuminosityOpacity="0.1"
                             FallbackColor="#1DFFFFFF"
                             d:DataContext="{d:DesignInstance Type=views:MainPage, IsDesignTimeCreatable=True}"
                             AlwaysUseFallback="{x:Bind AcrylicEffectsService.UseFallback, Mode=OneWay}" />

        <media2:AcrylicBrush x:Key="MyAcrylicBrushTitleText"
                             BackgroundSource="Backdrop"
                             TintColor="#FCFCFC"
                             TintOpacity="0.7"
                             TintLuminosityOpacity="0.8"
                             FallbackColor="#DDFCFCFC"
                             d:DataContext="{d:DesignInstance Type=views:MainPage, IsDesignTimeCreatable=True}"
                             AlwaysUseFallback="{x:Bind AcrylicEffectsService.UseFallback, Mode=OneWay}" />

        <!--<media2:AcrylicBrush x:Key="MyAcrylicBrushButton"
                             BackgroundSource="Backdrop"
                             TintColor="#222CFCFC"
                             TintOpacity="0.7"
                             TintLuminosityOpacity="0.8"
                             FallbackColor="#1DFFFFFF"
                             d:DataContext="{d:DesignInstance Type=views:MainPage, IsDesignTimeCreatable=True}"
                             AlwaysUseFallback="{x:Bind AcrylicEffectsService.UseFallback, Mode=OneWay}" />-->

        <!--<media:BackdropBlurBrush x:Key="TonyBrush" Amount="7" />-->

        <!-- Local build: the settings panel. An opaque gradient from dark grey at the top
             to blue grey at the bottom. -->
        <LinearGradientBrush x:Key="PanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2B2B2D" Offset="0" />
            <GradientStop Color="#2B3547" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#24FFFFFF" />

        <Style x:Key="SettingsHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ControlFullStretchStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        </Style>


        <Style x:Key="SelectedDayButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="#1f2022" />
            <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
            <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" /> <!-- moddato -->
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="ContentPresenter"
                                          AutomationProperties.AccessibilityView="Raw"
                                          Background="{TemplateBinding Background}"
                                          BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Content="{TemplateBinding Content}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#303236" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonForegroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1f2022" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonForegroundPressed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <PointerDownThemeAnimation Storyboard.TargetName="ContentPresenter" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBackgroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="{ThemeResource ButtonForegroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>


        <ParallaxView
            Grid.RowSpan="10"
            Source="{x:Bind MainScroll}" VerticalShift="50">
            <Grid x:Name="ParallaxContainer">
                <Image x:Name="Image1" Stretch="UniformToFill" Opacity="1">
                </Image>
                <Image x:Name="Image2" Stretch="UniformToFill" Opacity="0" />
            </Grid>
        </ParallaxView>

        <!-- Local build: darkens or lightens the background image, so the text keeps enough contrast.
             Color and opacity are set in code from the "Background contrast" setting. -->
        <Rectangle x:Name="BackgroundScrim"
                   Grid.RowSpan="10"
                   Fill="Black"
                   Opacity="0"
                   IsHitTestVisible="False" />


        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid" Background="Transparent"
                  Grid.Row="0">
                <!-- Width of the padding columns is set in LayoutMetricsChanged handler. -->
                <!-- Using padding columns instead of Margin ensures that the background
             paints the area under the caption control buttons (for transparent buttons). -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- Local build: keeps the room of the app icon. The icon itself is TitleIconHost
                     further down, outside this drag area, so it can show a tooltip. -->
                <Border Grid.Column="1"
                        Width="36" Height="28"
                        Margin="12,0,0,0" />
                <TextBlock x:Name="AppTitleTextBlock"
                           Text="test"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Margin="0,0,0,0" />
            </Grid>

            <!-- Local build: the widths of the named columns in the top bar are set in UpdateTitleBarLayout,
                 so the buttons and the search box never cover the app name or the window buttons. -->
            <Grid HorizontalAlignment="Stretch"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="SettingsRightColumn" Width="190" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AppbarSettingsButton" Width="52" x:Uid="AppbarSettingsButton">
                        <StackPanel>
                            <muxc:AnimatedIcon Width="20" x:Name='AnimatedIcon'>
                                <muxc:AnimatedIcon.Source>
                                    <animatedVisuals:AnimatedSettingsVisualSource />
                                </muxc:AnimatedIcon.Source>
                                <muxc:AnimatedIcon.FallbackIconSource>
                                    <muxc:FontIconSource FontFamily="{StaticResource FluentIcons}" Glyph="&#xE713;" />
                                </muxc:AnimatedIcon.FallbackIconSource>
                            </muxc:AnimatedIcon>
                        </StackPanel>

                        <Button.Flyout>
                            <MenuFlyout x:Name="SettingsFlyout">
                                <!-- Local build: an opaque panel with a grey to blue grey gradient.
                                     Its text is always light. -->
                                <MenuFlyout.MenuFlyoutPresenterStyle>
                                    <Style TargetType="MenuFlyoutPresenter">
                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MaxWidth" Value="520" />
                                        <Setter Property="RequestedTheme" Value="Dark" />
                                    </Style>
                                </MenuFlyout.MenuFlyoutPresenterStyle>

                                <MenuFlyoutItem>
                                    <MenuFlyoutItem.Template>
                                        <ControlTemplate x:Name="FlyoutItemSettingsTemp">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollMode="Disabled"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <!-- Local build: the sections sit in Auto rows. The star rows between
                                                     them share the extra height, so the panel fills the window height.
                                                     SettingsPanel_Loaded sets the height. -->
                                                <Grid Width="470"
                                                      Padding="18,12,18,12"
                                                      RequestedTheme="Dark"
                                                      Loaded="SettingsPanel_Loaded">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" MinHeight="18" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Units and time format -->
                                                    <Grid Grid.Row="0" ColumnSpacing="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock x:Uid="UnitsSettingsTitle"
                                                                       Style="{StaticResource SettingsHeaderStyle}" />
                                                            <controls1:Segmented
                                                                SelectedIndex="{Binding SettingsUnitsSelectedIndex}"
                                                                FontSize="13"
                                                                x:Name="UnitsSegmented"
                                                                SelectionChanged="UnitsSegmented_OnSelectionChanged"
                                                                d:DataContext="{d:DesignInstance views:MainPage }">
                                                                <controls1:SegmentedItem x:Uid="MetricUnitsItem" />
                                                                <controls1:SegmentedItem x:Uid="ImperialUnitsItem" />
                                                                <controls1:SegmentedItem x:Uid="HybridUnitsItem" />
                                                            </controls1:Segmented>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Uid="TimeFormatSettingsTitle"
                                                                       Style="{StaticResource SettingsHeaderStyle}" />
                                                            <controls1:Segmented
                                                                SelectedIndex="{Binding SettingsTimeFormatSelectedIndex}"
                                                                FontSize="13"
                                                                x:Name="TimeFormatSegmented"
                                                                SelectionChanged="TimeFormatSegmented_OnSelectionChanged"
                                                                d:DataContext="{d:DesignInstance views:MainPage }">
                                                                <controls1:SegmentedItem x:Uid="Segmented24hours" />
                                                                <controls1:SegmentedItem x:Uid="Segmented12hours" />
                                                            </controls1:Segmented>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Size of the text and pictures in the main area.
                                                         Buttons, because a drop-down list does not take mouse clicks
                                                         reliably inside this flyout. -->
                                                    <StackPanel Grid.Row="2">
                                                        <TextBlock x:Uid="UiSizeSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    d:DataContext="{d:DesignInstance views:MainPage }">
                                                            <Button MinWidth="40"
                                                                    FontSize="13"
                                                                    Content="&#x2212;"
                                                                    ToolTipService.ToolTip="Ctrl+Minus"
                                                                    Click="UiScaleSmallerButton_OnClick" />
                                                            <TextBlock Tag="UiScaleValue"
                                                                       Text="{Binding UiScaleText}"
                                                                       MinWidth="48"
                                                                       FontSize="13"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="SemiBold" />
                                                            <Button MinWidth="40"
                                                                    FontSize="13"
                                                                    Content="+"
                                                                    ToolTipService.ToolTip="Ctrl+Plus"
                                                                    Click="UiScaleLargerButton_OnClick" />
                                                            <Button Content="100%"
                                                                    FontSize="13"
                                                                    ToolTipService.ToolTip="Ctrl+0"
                                                                    Click="UiScaleResetButton_OnClick" />
                                                        </StackPanel>
                                                        <TextBlock x:Uid="UiSizeSettingsHint"
                                                                   Style="{StaticResource SettingsHintStyle}" />
                                                    </StackPanel>

                                                    <!-- How many hours the hourly forecast shows -->
                                                    <StackPanel Grid.Row="4">
                                                        <TextBlock x:Uid="HourlyRangeSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <controls1:Segmented
                                                            SelectedIndex="{Binding SettingsHourlyRangeSelectedIndex}"
                                                            FontSize="13"
                                                            x:Name="HourlyRangeSegmented"
                                                            SelectionChanged="HourlyRangeSegmented_OnSelectionChanged"
                                                            d:DataContext="{d:DesignInstance views:MainPage }">
                                                            <controls1:SegmentedItem x:Uid="HourlyRangeDay" />
                                                            <controls1:SegmentedItem x:Uid="HourlyRange24" />
                                                            <controls1:SegmentedItem x:Uid="HourlyRange36" />
                                                            <controls1:SegmentedItem x:Uid="HourlyRange48" />
                                                        </controls1:Segmented>
                                                        <TextBlock x:Uid="HourlyRangeHint"
                                                                   Style="{StaticResource SettingsHintStyle}" />
                                                    </StackPanel>

                                                    <!-- Acrylic effects and background image -->
                                                    <Grid Grid.Row="6" ColumnSpacing="30">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock x:Uid="AcrylicEffectsSettingsTitle"
                                                                       Style="{StaticResource SettingsHeaderStyle}" />
                                                            <ToggleSwitch x:Name="AcrylicToggle"
                                                                          MinWidth="0"
                                                                          FontSize="13"
                                                                          d:DataContext="{d:DesignInstance views:MainPage }"
                                                                          IsOn="{Binding AcrylicEffectsService.EffectsEnabled, Mode=OneWay}"
                                                                          Toggled="AcrylicToggle_OnToggled" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock x:Uid="BackgroundImageSettingsTitle"
                                                                       Style="{StaticResource SettingsHeaderStyle}" />
                                                            <ToggleSwitch x:Name="BackgroundImageToggle"
                                                                          MinWidth="0"
                                                                          FontSize="13"
                                                                          d:DataContext="{d:DesignInstance views:MainPage }"
                                                                          IsOn="{Binding BackgroundImageToggleStatus}"
                                                                          Toggled="BackgroundImageToggle_OnToggled" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Contrast between the background image and the text -->
                                                    <StackPanel Grid.Row="8">
                                                        <TextBlock x:Uid="BackgroundContrastSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <controls1:Segmented
                                                            SelectedIndex="{Binding SettingsBackgroundContrastSelectedIndex}"
                                                            FontSize="13"
                                                            x:Name="BackgroundContrastSegmented"
                                                            SelectionChanged="BackgroundContrastSegmented_OnSelectionChanged"
                                                            d:DataContext="{d:DesignInstance views:MainPage }">
                                                            <controls1:SegmentedItem x:Uid="BackgroundContrastOriginal" />
                                                            <controls1:SegmentedItem x:Uid="BackgroundContrastDark" />
                                                            <controls1:SegmentedItem x:Uid="BackgroundContrastDarker" />
                                                            <controls1:SegmentedItem x:Uid="BackgroundContrastLight" />
                                                            <controls1:SegmentedItem x:Uid="BackgroundContrastLighter" />
                                                        </controls1:Segmented>
                                                        <TextBlock x:Uid="BackgroundContrastHint"
                                                                   Style="{StaticResource SettingsHintStyle}" />
                                                    </StackPanel>

                                                    <!-- How strongly the cards are tinted over the background image -->
                                                    <StackPanel Grid.Row="10">
                                                        <TextBlock x:Uid="CardTintSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <Slider x:Name="CardTintSlider"
                                                                    x:Uid="CardTintSlider"
                                                                    Width="250"
                                                                    Minimum="0"
                                                                    Maximum="100"
                                                                    StepFrequency="5"
                                                                    SmallChange="5"
                                                                    LargeChange="10"
                                                                    Value="{Binding SettingsCardTint, Mode=OneTime}"
                                                                    ValueChanged="CardTintSlider_OnValueChanged"
                                                                    d:DataContext="{d:DesignInstance views:MainPage }" />
                                                            <TextBlock Loaded="CardTintValueText_OnLoaded"
                                                                       Text="0%"
                                                                       FontSize="13"
                                                                       Margin="12,0,0,0"
                                                                       MinWidth="40"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock x:Uid="CardTintHint"
                                                                   Margin="0"
                                                                   Style="{StaticResource SettingsHintStyle}" />
                                                    </StackPanel>

                                                    <!-- Option buttons instead of a drop-down list,
                                                         which does not take mouse clicks reliably inside this flyout. -->
                                                    <StackPanel Grid.Row="12">
                                                        <TextBlock x:Uid="AutoRefreshSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <controls1:Segmented
                                                            SelectedIndex="{Binding AutoRefreshPeriodSelectedIndex, Mode=OneWay}"
                                                            FontSize="13"
                                                            x:Name="AutoRefreshSegmented"
                                                            SelectionChanged="AutoRefreshSegmented_OnSelectionChanged"
                                                            d:DataContext="{d:DesignInstance views:MainPage }">
                                                            <controls1:SegmentedItem Content="Off" />
                                                            <controls1:SegmentedItem Content="15 min" />
                                                            <controls1:SegmentedItem Content="30 min" />
                                                            <controls1:SegmentedItem Content="1 h" />
                                                        </controls1:Segmented>
                                                    </StackPanel>

                                                    <!-- Language of the app and of the weather text. Opens a separate
                                                         window with the full list. A long drop-down list does not
                                                         scroll well inside this flyout. -->
                                                    <StackPanel Grid.Row="14">
                                                        <TextBlock x:Uid="LanguageSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />
                                                        <Button x:Name="LanguageButton"
                                                                MinWidth="200"
                                                                FontSize="13"
                                                                HorizontalContentAlignment="Left"
                                                                d:DataContext="{d:DesignInstance views:MainPage }"
                                                                Content="{Binding CurrentLanguageName}"
                                                                Click="LanguageButton_OnClick" />
                                                    </StackPanel>

                                                    <!-- Credits -->
                                                    <StackPanel Grid.Row="16">
                                                        <TextBlock x:Uid="CreditsSettingsTitle"
                                                                   Style="{StaticResource SettingsHeaderStyle}" />

                                                        <RichTextBlock FontSize="13" LineHeight="21">
                                                            <Paragraph>
                                                                <Run Text="FluentWeather-Plus" FontWeight="Bold" />
                                                                <Hyperlink
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    NavigateUri="https://github.com/Duedilly108/FluentWeather-Plus/releases"><Run
                                                                        d:DataContext="{d:DesignInstance views:MainPage }"
                                                                        Text="{Binding MainPageViewModel.PlusVersionText}" /></Hyperlink>
                                                                <Run x:Uid="UpdatedByRun" />
                                                                <Hyperlink
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    NavigateUri="https://github.com/Duedilly108">duedilly108</Hyperlink>
                                                            </Paragraph>
                                                            <Paragraph>
                                                                <Run x:Uid="BasedOnRun" />
                                                                <Run Text="FluentWeather" FontWeight="Bold" />
                                                                <Hyperlink
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    Click="ChangelogHyperlink_Click"><Run
                                                                        d:DataContext="{d:DesignInstance views:MainPage }"
                                                                        Text="{Binding MainPageViewModel.AppVersionText}" /></Hyperlink>
                                                                <Run x:Uid="DevelopedByRun" />
                                                                <Hyperlink
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    NavigateUri="https://github.com/Gabboxl">Gabboxl</Hyperlink>
                                                            </Paragraph>
                                                            <Paragraph>
                                                                <Run x:Uid="InspiredByRun" />
                                                                <Hyperlink
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    NavigateUri="https://twitter.com/zeealeid">@zeealeid</Hyperlink>
                                                            </Paragraph>
                                                        </RichTextBlock>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Margin="-12,2,0,0">
                                                            <HyperlinkButton
                                                                NavigateUri="https://github.com/Duedilly108/FluentWeather-Plus">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Grid Width="16" Height="16">
                                                                        <Path
                                                                            Data="{StaticResource GithubIconPath}"
                                                                            Stretch="Uniform"
                                                                            Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                                    </Grid>
                                                                    <TextBlock x:Uid="GithubProjectButton" FontSize="13" />
                                                                </StackPanel>
                                                            </HyperlinkButton>

                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </MenuFlyoutItem.Template>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

            </Grid>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="RefreshLeftColumn" Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <muxc:ProgressRing x:Name="DataProgressRing"
                                   Grid.Column="1"
                                   IsTabStop="True"
                                   Width="22"
                                   Height="22"
                                   IsActive="{x:Bind MainPageViewModel.IsLoadingData , Mode=OneWay}"
                                   Margin="12,0,0,0" />

                <AppBarButton x:Name="RefreshButton" Grid.Column="1" Icon="Refresh" IsCompact="False"
                              Click="RefreshButton_OnClick" Width="52" x:Uid="RefreshButton">
                </AppBarButton>
            </Grid>


            <Grid HorizontalAlignment="Stretch"
                  Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftMarginColumn" Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SearchRightColumn" Width="240" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" MaxWidth="500">

                    <AutoSuggestBox
                        x:Uid="SearchAutoSuggestBox"
                        FontSize="13"
                        x:Name="AutoSuggestBoxMain"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutoMaximizeSuggestionArea="True"
                        MaxSuggestionListHeight="700"
                        QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                        KeyUp="AutoSuggestBoxMain_OnKeyUp"
                        KeyDown="AutoSuggestBoxMain_OnKeyUp"

                        Style="{ThemeResource DefaultAutoSuggestBoxStyle}"
                        UpdateTextOnSelect="False"

                        TextMemberPath="address"
                        SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                        ItemContainerStyle="{StaticResource ControlFullStretchStyle}"
                        AutomationProperties.Name="Basic AutoSuggestBox">

                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchedLocation">
                                <RelativePanel Margin="2,0,0,0">

                                    <FontIcon x:Name="icon"
                                              FontSize="24"
                                              RelativePanel.AlignVerticalCenterWithPanel="True"
                                              FontFamily="{StaticResource FluentIcons}" Glyph="&#xE707;" />


                                    <TextBlock x:Name="text1" Text="{x:Bind address}"
                                               Margin="8,0,0,0"
                                               TextWrapping="WrapWholeWords"
                                               RelativePanel.RightOf="icon"
                                               RelativePanel.AlignRightWithPanel="True"
                                               RelativePanel.AlignVerticalCenterWithPanel="True" />
                                </RelativePanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>

                    </AutoSuggestBox>
                </Grid>
            </Grid>

            <!-- Local build: the app icon with a small "P" badge for FluentWeather-Plus. It sits in the
                 top left corner, on top of the title bar but outside its drag area, so hovering
                 shows the name and the version. -->
            <Grid x:Name="TitleIconHost"
                  Grid.Row="0"
                  Width="36" Height="32"
                  Margin="12,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="Transparent">
                <Image Source="/Assets/Square44x44Logo.png"
                       Width="28" Height="28"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />
                <Border Background="#4AA3FF"
                        CornerRadius="2"
                        Padding="2,0,2,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0">
                    <TextBlock Text="P"
                               FontSize="7"
                               FontWeight="Bold"
                               LineHeight="9"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="#06203D" />
                </Border>
            </Grid>
        </Grid>


        <!-- Local build: the content is drawn at the size chosen in "Text and picture size".
             The Canvas does not limit the size of its child, so the scaled grid is not clipped twice. -->
        <Canvas Grid.Row="1" x:Name="ZoomHost" SizeChanged="ZoomHost_SizeChanged">
        <Grid x:Name="MainInnerContentGrid"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- animate the content of the grid when making it visible -->
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="250" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>


            <RefreshContainer x:Name="RefreshContainer" RefreshRequested="RefContainer_RefreshRequested" Grid.Row="1">
                <ScrollViewer
                    x:Name="MainScroll"
                    VerticalScrollMode="Enabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <Grid Padding="40,64,0,64">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <RelativePanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="4,0,0,0">
                                <FontIcon x:Name="PlaceIcon"
                                          FontSize="24"
                                          RelativePanel.AlignVerticalCenterWithPanel="True"
                                          FontFamily="{StaticResource FluentIcons}" Glyph="&#xE707;" />

                                <TextBlock x:Name="PlaceText" Text="place"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           Margin="8,0,0,0"
                                           RelativePanel.RightOf="PlaceIcon" />

                                <!-- Pin or unpin the location that is shown -->
                                <Button x:Name="SaveLocationButton"
                                        Margin="6,0,0,0"
                                        Padding="6,4,6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        RelativePanel.RightOf="PlaceText"
                                        RelativePanel.AlignVerticalCenterWith="PlaceText"
                                        Click="SaveLocationButton_OnClick">
                                    <FontIcon x:Name="SaveLocationIcon"
                                              FontSize="16"
                                              FontFamily="{StaticResource FluentIcons}"
                                              Glyph="&#xE734;" />
                                </Button>

                                <TextBlock x:Name="UpdatedOnText" Text="updatedOn"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="{ThemeResource TextControlBackgroundThemeOpacity}"
                                           Margin="8,0,0,0"
                                           RelativePanel.Below="PlaceText"
                                           RelativePanel.AlignLeftWith="PlaceText" />

                            </RelativePanel>

                            <!-- Saved locations. Click to switch. Right-click for more options. -->
                            <ScrollViewer x:Name="SavedLocationsScroll"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          Margin="0,12,40,0"
                                          Visibility="Collapsed"
                                          HorizontalScrollMode="Enabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <muxc:ItemsRepeater x:Name="SavedLocationsRepeater"
                                                    Margin="0,0,0,8">
                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:StackLayout Orientation="Horizontal" Spacing="8" />
                                    </muxc:ItemsRepeater.Layout>

                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:SavedLocation">
                                            <ToggleButton DataContext="{x:Bind}"
                                                          IsChecked="{x:Bind IsActive}"
                                                          ToolTipService.ToolTip="{x:Bind ToolTipText}"
                                                          AutomationProperties.Name="{x:Bind FullName}"
                                                          CornerRadius="16"
                                                          Padding="14,5,14,6"
                                                          Click="SavedLocationChip_OnClick"
                                                          ContextRequested="SavedLocationChip_OnContextRequested">
                                                <TextBlock Text="{x:Bind Label}"
                                                           MaxWidth="240"
                                                           TextTrimming="CharacterEllipsis" />
                                            </ToggleButton>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>
                                </muxc:ItemsRepeater>
                            </ScrollViewer>

                            <!-- How to save locations. The text is set in code. With no saved locations it is
                                 always shown. With saved locations it is a short tip that can be hidden. -->
                            <!-- A Grid, so the text wraps to the width of the window. -->
                            <Grid x:Name="SavedLocationsHintPanel"
                                  Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  HorizontalAlignment="Left"
                                  MaxWidth="680"
                                  Margin="4,10,40,0"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0"
                                          FontSize="14"
                                          Margin="0,3,0,0"
                                          VerticalAlignment="Top"
                                          Opacity="0.85"
                                          FontFamily="{StaticResource FluentIcons}"
                                          Glyph="&#xE734;" />
                                <TextBlock x:Name="SavedLocationsHintText"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Top"
                                           Opacity="0.85"
                                           TextWrapping="WrapWholeWords"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <Button x:Name="SavedLocationsHintCloseButton"
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="6,4,6,4"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SavedLocationsHintCloseButton_OnClick">
                                    <FontIcon FontSize="10"
                                              FontFamily="{StaticResource FluentIcons}"
                                              Glyph="&#xE711;" />
                                </Button>
                            </Grid>

                        </Grid>


                        <RelativePanel
                            Grid.Row="1">

                            <Image x:Name="MainIcon"
                                   Width="75"
                                   RelativePanel.AlignVerticalCenterWithPanel="True"
                                   Stretch="Uniform">
                                <Image.Source>
                                    <SvgImageSource />
                                </Image.Source>
                            </Image>

                            <TextBlock x:Name="CurrentTempText" Text="temperature"
                                       Style="{StaticResource DisplayTextBlockStyle}"
                                       Margin="8,0,0,0"
                                       RelativePanel.RightOf="MainIcon" />

                            <TextBlock x:Name="MainPhraseText" Text="phrase"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       Margin="16,0,0,0"
                                       RelativePanel.Above="FeelsLikeText"
                                       RelativePanel.AlignLeftWith="FeelsLikeText" />


                            <TextBlock x:Name="FeelsLikeText" Text="feelslike"

                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="16,0,0,16"
                                       Opacity="{ThemeResource TextControlBackgroundRestOpacity}"
                                       RelativePanel.AlignBottomWithPanel="True"
                                       RelativePanel.RightOf="CurrentTempText" />
                        </RelativePanel>


                        <!-- Local build: the detail cards scroll sideways in a narrow window, with a scroll bar
                             below them. The bottom margin leaves room for the scroll bar. -->
                        <ScrollViewer Grid.Row="2"
                                      Margin="0,16,0,0"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,14">

                            <controls:DetailChipControl
                                x:Name="WindChipControl"
                                x:Uid="WindChipControl">
                            </controls:DetailChipControl>

                            <controls:DetailChipControl
                                x:Name="HumidityChipControl"
                                x:Uid="HumidityChipControl">
                            </controls:DetailChipControl>

                            <controls:DetailChipControl
                                x:Name="UVIndexChipControl"
                                x:Uid="UVIndexChipControl">
                            </controls:DetailChipControl>

                            <!-- Local build: air quality from Open-Meteo. Hidden until the data arrives. -->
                            <controls:DetailChipControl
                                x:Name="AirQualityChipControl"
                                x:Uid="AirQualityChipControl"
                                Visibility="Collapsed">
                            </controls:DetailChipControl>

                            <controls:DetailChipControl
                                x:Name="VisibilityChipControl"
                                x:Uid="VisibilityChipControl">
                            </controls:DetailChipControl>

                            <controls:DetailChipControl
                                x:Name="PressureChipControl"
                                x:Uid="PressureChipControl">
                            </controls:DetailChipControl>

                            <controls:DetailChipControl
                                x:Name="DewPointChipControl"
                                x:Uid="DewPointChipControl">
                            </controls:DetailChipControl>

                            <!--<controls:DetailChipControl
                                x:Name="CloudCoverChipControl"
                                x:Uid="CloudCoverChipControl">
                            </controls:DetailChipControl>-->

                        </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="3"
                              Margin="0,32,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                x:Uid="DailyForecastTitleTextBlock"
                                Style="{StaticResource SubtitleTextBlockStyle}"

                                Margin="0,0,0,16" />

                            <ScrollViewer x:Name="DaysScroll"
                                          Grid.Row="1"
                                          VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Auto"
                                          ViewChanged="DaysScroll_OnViewChanged">

                                <!-- The bottom margin leaves room for the scroll bar below the cards. -->
                                <StackPanel x:Name="DaysRowPanel"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,14"
                                            PointerWheelChanged="DaysRowPanel_OnPointerWheelChanged"
                                            KeyDown="DaysRowPanel_OnKeyDown">

                                <!-- Local build: "Past days". The recorded days before today, oldest first. The code
                                     fills this panel and scrolls the row so that today is the first day in view. -->
                                <StackPanel x:Name="PastDaysPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,0,8,0"
                                            Visibility="Collapsed" />

                                <muxc:ItemsRepeater
                                    x:Name="RepeaterDays">

                                    <muxc:ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="adapters:DayButtonAdapter">
                                            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                    DataContext="{x:Bind}"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"
                                                    Width="135"
                                                    Height="70"
                                                    Click="DayButtonClick">
                                                <Button.Content>
                                                    <RelativePanel HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch">

                                                        <Image x:Name="mainIcon"
                                                               Width="28"
                                                               RelativePanel.AlignVerticalCenterWithPanel="True"
                                                               Stretch="Uniform"
                                                               RelativePanel.AlignTopWithPanel="True"
                                                               RelativePanel.AlignLeftWithPanel="True"
                                                               Source="{x:Bind SvgImageIcon}">
                                                        </Image>

                                                        <TextBlock Text="{x:Bind ShortDayName }"
                                                                   RelativePanel.AlignTopWithPanel="True"
                                                                   RelativePanel.AlignRightWithPanel="True" />

                                                        <TextBlock
                                                            Text="{x:Bind Temperature }"
                                                            RelativePanel.AlignBottomWithPanel="True"
                                                            RelativePanel.AlignLeftWithPanel="True">
                                                        </TextBlock>

                                                        <Image x:Name="precipIcon"
                                                               Width="16"
                                                               RelativePanel.AlignVerticalCenterWithPanel="True"
                                                               Stretch="Uniform"
                                                               RelativePanel.AlignBottomWithPanel="True"
                                                               RelativePanel.LeftOf="precipChanceText"
                                                               Margin="0,0,4,0"
                                                               Source="{x:Bind SvgPrecipIcon}">

                                                        </Image>

                                                        <TextBlock
                                                            x:Name="precipChanceText"
                                                            Text="{x:Bind PrecipitationChance}"
                                                            RelativePanel.AlignBottomWithPanel="True"
                                                            RelativePanel.AlignRightWithPanel="True">
                                                        </TextBlock>
                                                    </RelativePanel>
                                                </Button.Content>

                                            </Button>
                                        </DataTemplate>
                                    </muxc:ItemsRepeater.ItemTemplate>

                                    <muxc:ItemsRepeater.Layout>
                                        <muxc:StackLayout Spacing="8"
                                                          Orientation="Horizontal" />
                                    </muxc:ItemsRepeater.Layout>
                                </muxc:ItemsRepeater>

                                </StackPanel>

                            </ScrollViewer>
                        </Grid>


                        <Grid Grid.Row="4"
                              Margin="0,32,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <RelativePanel Grid.Row="0">
                                <TextBlock
                                    x:Name="HourlyTitleText"
                                    x:Uid="HourlyTitleText"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    FontSize="20"
                                    Margin="0,0,0,16" />

                            </RelativePanel>


                            <Grid
                                Margin="0,0,32,0"
                                Grid.Row="1"
                                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                CornerRadius="8"
                                Padding="12"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource MyAcrylicBrush}"
                                Background="{ThemeResource MyAcrylicBrush}">

                                <ListView x:Name="HourlyListview"

                                          Padding="0,0,0,18"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Enabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                          ScrollViewer.IsDeferredScrollingEnabled="False"
                                          SelectionMode="None">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="adapters:HourDataAdapter">
                                            <Grid Width="100" Height="200" Margin="0">
                                                <Button VerticalAlignment="Stretch"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent">

                                                    <!-- detailed hourly data flyout -->
                                                    <Button.Flyout>
                                                        <MenuFlyout x:Name="HourlyDataFlyout">

                                                            <MenuFlyoutItem>
                                                                <MenuFlyoutItem.Template>
                                                                    <ControlTemplate x:Name="FlyoutItemHourlyDataTemp"
                                                                        TargetType="MenuFlyoutItem">
                                                                        <StackPanel VerticalAlignment="Center"
                                                                            Margin="16">

                                                                            <StackPanel Orientation="Horizontal"
                                                                                Margin="0,0,0,16">
                                                                                <TextBlock x:Name="HourlyDataTitleText"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="{Binding Hour}"
                                                                                    Style="{StaticResource SubtitleTextBlockStyle}" />

                                                                                <!-- only "-" characher textblock -->
                                                                                <TextBlock
                                                                                    Margin="4,0,2,0"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="-"
                                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                    FontSize="18">
                                                                                </TextBlock>


                                                                                <TextBlock
                                                                                    VerticalAlignment="Center"
                                                                                    x:Uid="HourlyDetailedDataTitle"
                                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                                    FontSize="18" />
                                                                            </StackPanel>


                                                                            <controls1:UniformGrid Columns="3">

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding TemperatureFeelsLike}"
                                                                                    Title="{x:Bind helpers:ResourceExtensions.GetLocalized('FeelsLikeText', x:False, x:Null)}">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding WindSpeed}"
                                                                                    x:Uid="WindChipControl">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding CloudCover}"
                                                                                    x:Uid="CloudCoverChipControl">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding RainAmount}"
                                                                                    x:Uid="RainAmountChipControl">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding Pressure}"
                                                                                    x:Uid="PressureChipControl">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding Humidity}"
                                                                                    x:Uid="HumidityChipControl">
                                                                                </controls:DetailChipControl>

                                                                                <controls:DetailChipControl
                                                                                    Value="{Binding UvIndex}"
                                                                                    x:Uid="UVIndexChipControl">
                                                                                </controls:DetailChipControl>

                                                                            </controls1:UniformGrid>

                                                                        </StackPanel>
                                                                    </ControlTemplate>
                                                                </MenuFlyoutItem.Template>
                                                            </MenuFlyoutItem>

                                                        </MenuFlyout>
                                                    </Button.Flyout>


                                                    <RelativePanel VerticalAlignment="Stretch"
                                                                   HorizontalAlignment="Stretch">

                                                        <Image x:Name="wetIcon"
                                                               Margin="0,8,0,0"
                                                               Width="40"
                                                               RelativePanel.AlignVerticalCenterWithPanel="True"
                                                               Stretch="Uniform"
                                                               RelativePanel.AlignTopWithPanel="True"
                                                               RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                               Source="{x:Bind SvgImageIcon}">
                                                        </Image>

                                                        <TextBlock x:Name="TemperatureText"
                                                                   Text="{x:Bind Temperature }"
                                                                   RelativePanel.Below="wetIcon"
                                                                   RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                                   TextAlignment="Center"
                                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                                   FontSize="28">
                                                        </TextBlock>

                                                        <!-- phrase text -->
                                                        <TextBlock Text="{x:Bind Phrase }"
                                                                   RelativePanel.Below="TemperatureText"
                                                                   RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                                   TextAlignment="Center"
                                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                                   FontSize="12">
                                                        </TextBlock>

                                                        <StackPanel Orientation="Horizontal"
                                                                    RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                                    RelativePanel.Above="Rectangle2">

                                                            <!-- precip icon -->
                                                            <Image x:Name="precipIcon"
                                                                   VerticalAlignment="Center"
                                                                   Width="16"
                                                                   Stretch="Uniform"
                                                                   Margin="0,0,4,0"
                                                                   Source="{x:Bind SvgPrecipIcon}" />

                                                            <!-- precip chance text -->
                                                            <TextBlock x:Name="precipChanceText"

                                                                       Text="{x:Bind PrecipitationChance}">
                                                            </TextBlock>
                                                        </StackPanel>


                                                        <!-- horizontal line -->
                                                        <Rectangle x:Name="Rectangle2"
                                                                   Fill="#7FAFAFAF"
                                                                   Height="1"
                                                                   RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                                   RelativePanel.Above="HourText"
                                                                   Width="90"
                                                                   Margin="0,8,0,0" />

                                                        <TextBlock x:Name="HourText"
                                                                   Text="{Binding Hour}"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                                   RelativePanel.AlignBottomWithPanel="True" />

                                                    </RelativePanel>

                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </Grid>


                        </Grid>


                        <Grid Grid.Row="5"
                              Margin="0,32,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <RelativePanel Grid.Row="0">
                                <TextBlock
                                    x:Name="WeatherInsightsTitleText"
                                    x:Uid="WeatherInsightsTitleText"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    FontSize="20"
                                    Margin="0,0,0,16" />


                            </RelativePanel>


                            <controls1:WrapPanel
                                Grid.Row="1">
                                <controls:InsightControl x:Name="RunningInsight"></controls:InsightControl>
                                <controls:InsightControl x:Name="DrivingInsight"></controls:InsightControl>

                                <!--
                            <controls:InsightControl x:Name="PollenInsight"></controls:InsightControl>
                            -->

                                <controls:InsightControl x:Name="WateringInsight"></controls:InsightControl>

                                <controls:InsightControl x:Name="DryskinInsight"></controls:InsightControl>
                            </controls1:WrapPanel>

                        </Grid>


                        <Grid Grid.Row="6"
                              Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>

                            <controls1:WrapPanel>
                                <Grid
                                    Margin="4"
                                    CornerRadius="6"
                                    Padding="0"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource MyAcrylicBrush}"
                                    Background="{ThemeResource MyAcrylicBrush}"
                                    Width="293">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <RelativePanel Grid.Row="0">

                                        <TextBlock x:Name="DaySummaryInsightTitle" x:Uid="DaySummaryInsightTitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Margin="8,8,0,0"
                                                   FontSize="16"
                                                   Foreground="{ThemeResource MyAcrylicBrushTitleText}"
                                                   RelativePanel.AlignTopWithPanel="True" />

                                        <Rectangle x:Name="Rectangle2"
                                                   Fill="{ThemeResource MyAcrylicBrushLine}"
                                                   Height="1.2"
                                                   RelativePanel.Below="DaySummaryInsightTitle"
                                                   RelativePanel.AlignRightWithPanel="True"
                                                   RelativePanel.AlignLeftWithPanel="True"
                                                   RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                   Margin="16,6,16,0" />
                                    </RelativePanel>

                                    <RelativePanel Grid.Row="1"
                                                   Margin="8">

                                        <TextBlock x:Name="DaySummaryInsightSubtitle" x:Uid="DaySummaryInsightSubtitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Margin="0,0,0,0"
                                                   Opacity="0.6"
                                                   RelativePanel.AlignTopWithPanel="True" />

                                        <TextBlock x:Name="DaySummaryText" Text="hellox"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Margin="0,6,0,0"
                                                   IsTextSelectionEnabled="True"
                                                   RelativePanel.Below="DaySummaryInsightSubtitle" />

                                        <TextBlock x:Name="NightSummaryInsightSubtitle"
                                                   x:Uid="NightSummaryInsightSubtitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Margin="0,6,0,0"
                                                   Opacity="0.6"
                                                   RelativePanel.Below="DaySummaryText" />

                                        <TextBlock x:Name="NightSummaryText" Text="hello"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Margin="0,6,0,0"
                                                   IsTextSelectionEnabled="True"
                                                   RelativePanel.Below="NightSummaryInsightSubtitle" />


                                    </RelativePanel>


                                </Grid>


                                <Grid
                                    VerticalAlignment="Stretch"
                                    Margin="4"
                                    CornerRadius="6"
                                    Padding="0"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource MyAcrylicBrush}"
                                    Background="{ThemeResource MyAcrylicBrush}"
                                    Width="294">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <RelativePanel Grid.Row="0">

                                        <TextBlock x:Name="SunInsightTitle" x:Uid="SunInsightTitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Margin="8,8,0,0"
                                                   FontSize="16"
                                                   Foreground="{ThemeResource MyAcrylicBrushTitleText}"
                                                   RelativePanel.AlignTopWithPanel="True" />

                                        <Rectangle
                                            Fill="{ThemeResource MyAcrylicBrushLine}"
                                            Height="1.2"
                                            RelativePanel.Below="SunInsightTitle"
                                            RelativePanel.AlignRightWithPanel="True"
                                            RelativePanel.AlignLeftWithPanel="True"
                                            RelativePanel.AlignHorizontalCenterWithPanel="True"
                                            Margin="16,6,16,0" />
                                    </RelativePanel>

                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>


                                        <RelativePanel Grid.Row="0"
                                                       Margin="8">

                                            <Image x:Name="SunriseIcon"
                                                   Margin="0,8,0,0"
                                                   Width="40"
                                                   Stretch="Uniform"
                                                   RelativePanel.AlignTopWithPanel="True"
                                                   Source="/Assets/varicons/SunriseNew.svg">
                                            </Image>

                                            <TextBlock x:Name="SunriseSubtitle" x:Uid="SunriseSubtitle"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Margin="6,0,0,0"
                                                       Opacity="0.6"
                                                       RelativePanel.RightOf="SunriseIcon" />

                                            <TextBlock x:Name="SunriseTimeText" Text="risetime"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Margin="6,0,0,0"
                                                       RelativePanel.AlignLeftWith="SunriseSubtitle"
                                                       RelativePanel.Below="SunriseSubtitle" />


                                        </RelativePanel>

                                        <RelativePanel Grid.Row="1"
                                                       Margin="8">

                                            <Image x:Name="SunsetIcon"
                                                   Margin="0,8,0,0"
                                                   Width="40"
                                                   Stretch="Uniform"
                                                   RelativePanel.AlignTopWithPanel="True"
                                                   Source="/Assets/varicons/SunsetNew.svg">
                                            </Image>

                                            <TextBlock x:Name="SunsetSubtitle" x:Uid="SunsetSubtitle"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Margin="6,6,0,0"
                                                       Opacity="0.6"
                                                       RelativePanel.RightOf="SunsetIcon" />

                                            <TextBlock x:Name="SunsetTimeText" Text="settime"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Margin="6,0,0,0"
                                                       RelativePanel.AlignLeftWith="SunsetSubtitle"
                                                       RelativePanel.Below="SunsetSubtitle" />

                                        </RelativePanel>

                                    </Grid>


                                </Grid>


                                <Grid
                                    Margin="4"
                                    CornerRadius="6"
                                    Padding="0"
                                    BorderThickness="2"
                                    BorderBrush="{ThemeResource MyAcrylicBrush}"
                                    Background="{ThemeResource MyAcrylicBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"></RowDefinition>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <RelativePanel Grid.Row="0">

                                        <TextBlock x:Name="MoonInsightTitle" x:Uid="MoonInsightTitle"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Margin="8,8,0,0"
                                                   FontSize="16"
                                                   Foreground="{ThemeResource MyAcrylicBrushTitleText}"
                                                   RelativePanel.AlignTopWithPanel="True" />

                                        <Rectangle
                                            Fill="{ThemeResource MyAcrylicBrushLine}"
                                            Height="1.2"
                                            RelativePanel.Below="MoonInsightTitle"
                                            RelativePanel.AlignRightWithPanel="True"
                                            RelativePanel.AlignLeftWithPanel="True"
                                            RelativePanel.AlignHorizontalCenterWithPanel="True"
                                            Margin="16,6,16,0" />
                                    </RelativePanel>

                                    <Grid Grid.Row="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"></RowDefinition>
                                            <RowDefinition Height="*"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>


                                        <RelativePanel Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="8">

                                            <Image x:Name="MoonriseIcon"
                                                   Margin="0,8,0,0"
                                                   Width="40"
                                                   Stretch="Uniform"
                                                   RelativePanel.AlignTopWithPanel="True"
                                                   Source="/Assets/varicons/Moonrise.svg">
                                            </Image>

                                            <TextBlock x:Name="MoonriseSubtitle" x:Uid="MoonriseSubtitle"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Margin="6,6,0,0"
                                                       Opacity="0.6"
                                                       RelativePanel.RightOf="MoonriseIcon" />

                                            <TextBlock x:Name="MoonriseTimeText" Text="risetime"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Margin="6,2,0,0"
                                                       RelativePanel.AlignLeftWith="MoonriseSubtitle"
                                                       RelativePanel.Below="MoonriseSubtitle" />


                                        </RelativePanel>

                                        <RelativePanel Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="8">

                                            <Image x:Name="MoonsetIcon"
                                                   Margin="0,8,0,0"
                                                   Width="40"
                                                   Stretch="Uniform"
                                                   RelativePanel.AlignTopWithPanel="True"
                                                   Source="/Assets/varicons/Moonset.svg">
                                            </Image>

                                            <TextBlock x:Name="MoonsetSubtitle" x:Uid="MoonsetSubtitle"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Margin="6,6,0,0"
                                                       Opacity="0.6"
                                                       RelativePanel.RightOf="MoonsetIcon" />

                                            <TextBlock x:Name="MoonsetTimeText" Text="settime"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Margin="6,2,0,0"
                                                       RelativePanel.AlignLeftWith="MoonsetSubtitle"
                                                       RelativePanel.Below="MoonsetSubtitle" />

                                        </RelativePanel>

                                        <RelativePanel Grid.Row="0"
                                                       Grid.RowSpan="2"
                                                       Grid.Column="1"
                                                       Margin="8">

                                            <Rectangle
                                                x:Name="LunarphaseLine"
                                                Fill="{ThemeResource MyAcrylicBrushLine}"
                                                Height="100"
                                                Width="1.2"
                                                RelativePanel.AlignLeftWithPanel="True"
                                                RelativePanel.AlignTopWithPanel="True"
                                                Margin="0,8,0,0" />

                                            <Image x:Name="LunarphaseIcon"
                                                   Margin="6,8,0,0"
                                                   Width="40"
                                                   Stretch="Uniform"
                                                   RelativePanel.RightOf="LunarphaseLine"
                                                   RelativePanel.AlignTopWith="LunarphaseLine">
                                            </Image>

                                            <TextBlock x:Name="LunarphaseSubtitle" x:Uid="LunarphaseSubtitle"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       Margin="8,6,0,0"
                                                       Opacity="0.6"
                                                       RelativePanel.AlignTopWithPanel="True"
                                                       RelativePanel.RightOf="LunarphaseIcon" />

                                            <TextBlock x:Name="LunarphaseText" Text="phase"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Margin="8,2,0,0"
                                                       RelativePanel.AlignLeftWith="LunarphaseSubtitle"
                                                       RelativePanel.Below="LunarphaseSubtitle" />


                                        </RelativePanel>

                                    </Grid>


                                </Grid>

                            </controls1:WrapPanel>

                        </Grid>

                        <!-- Local build: radar map for US locations, from NOAA (radar and borders) and USGS (terrain).
                             The section is shown only when the location is inside a NOAA radar area. -->
                        <Grid x:Name="RadarSection"
                              Grid.Row="7"
                              Margin="0,32,0,0"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Uid="RadarTitleText"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       FontSize="20"
                                       Margin="0,0,0,16" />

                            <Grid Grid.Row="1"
                                  Margin="0,0,32,0"
                                  CornerRadius="8"
                                  Padding="12"
                                  BorderThickness="2"
                                  BorderBrush="{ThemeResource MyAcrylicBrush}"
                                  Background="{ThemeResource MyAcrylicBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="RadarMapHost"
                                      Height="320"
                                      SizeChanged="RadarMapHost_SizeChanged">
                                    <Canvas x:Name="RadarCanvas"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top" />

                                    <StackPanel HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Spacing="4">
                                        <Button x:Name="RadarZoomInButton"
                                                x:Uid="RadarZoomInButton"
                                                Padding="8"
                                                Click="RadarZoomInButton_OnClick">
                                            <FontIcon FontFamily="{StaticResource FluentIcons}"
                                                      FontSize="14"
                                                      Glyph="&#xE710;" />
                                        </Button>
                                        <Button x:Name="RadarZoomOutButton"
                                                x:Uid="RadarZoomOutButton"
                                                Padding="8"
                                                Click="RadarZoomOutButton_OnClick">
                                            <FontIcon FontFamily="{StaticResource FluentIcons}"
                                                      FontSize="14"
                                                      Glyph="&#xE738;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Margin="0,8,0,0"
                                      ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RadarTimeText"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"
                                               Opacity="0.8" />
                                    <TextBlock x:Uid="RadarCreditText"
                                               Grid.Column="1"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Top"
                                               Opacity="0.6" />
                                </Grid>
                            </Grid>
                        </Grid>


                    </Grid>
                </ScrollViewer>
            </RefreshContainer>

        </Grid>
        </Canvas>

    </Grid>

</Page>
