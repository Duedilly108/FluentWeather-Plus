<UserControl
    x:Class="FluentWeather.Controls.DetailChipControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <RelativePanel
        x:Name="ChipPanel"
        Margin="4"
        CornerRadius="6"
        Padding="8"
        BorderThickness="0"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="#1DFFFFFF"
        Width="108">

        <!-- textblock with BodyTextBlockStyle -->
        <TextBlock x:Name="TitleText" Text="chiptitle"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Margin="0,0,0,0"
                   Opacity="0.6" />

        <TextBlock x:Name="ValueText" Text="chipvalue"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,0,0,0"
                   RelativePanel.Below="TitleText" />

        <!-- Local build: an optional smaller line under the value. Hidden when empty. -->
        <TextBlock x:Name="NoteText"
                   FontSize="12"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0"
                   Visibility="Collapsed"
                   RelativePanel.Below="ValueText" />


    </RelativePanel>
</UserControl>
