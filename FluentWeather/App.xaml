<Application
    x:Class="FluentWeather.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <ResourceDictionary>

            <FontFamily x:Key="FluentIcons">/Assets/Fonts/SegoeFluentIcons.ttf#Segoe Fluent Icons</FontFamily>

            <x:Double x:Key="ContentDialogMaxWidth">2000</x:Double>

            <!-- Local build: tooltips use the grey to blue grey gradient of the settings panel. -->
            <Style TargetType="ToolTip">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2B2B2D" Offset="0" />
                            <GradientStop Color="#2B3547" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="RequestedTheme" Value="Dark" />
            </Style>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Assets/insighticons/Insighticons.xaml" />
                <ResourceDictionary Source="Assets/varicons/VariousIcons.xaml" />
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Button.xaml" />
                <ResourceDictionary Source="Styles/AutoSuggestBox.xaml" />
                <ResourceDictionary Source="Controls/NiceNavigationView/NavigationView.xaml" />
                <ResourceDictionary Source="Controls/NiceNavigationView/NavigationView.Themeresources.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>

</Application>
