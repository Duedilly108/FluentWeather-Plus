+                    }
+                };
+            }
+
+            public V2idxDrySkinDaypartResult DrySkin()
+            {
+                var (valid, local, ind, num, names) = IndexHeader();
+                var values = IndexParts().Select(p =>
+                {
+                    var a = Aggregate(p);
+                    var score = a.DewF >= 55 ? 1 : a.DewF >= 48 ? 3 : a.DewF >= 40 ? 5 : a.DewF >= 32 ? 6 : a.DewF >= 24 ? 7 : a.DewF >= 15 ? 8 : 9;
