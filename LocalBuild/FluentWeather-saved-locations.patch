+            private (DateTimeOffset? Rise, DateTimeOffset? Set) SunTimes(DateTime date)
+            {
+                var d = _om.Daily;
+                if (d?.Time == null)
+                    return (null, null);
+                var i = d.Time.IndexOf(date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture));
+                if (i < 0)
+                    return (null, null);
