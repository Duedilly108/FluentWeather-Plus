diff --git a/FluentWeather/Helpers/HoverScrollBar.cs b/FluentWeather/Helpers/HoverScrollBar.cs
new file mode 100644
index 0000000000000000000000000000000000000000..6c02610572fbb9257cd56a94ec455f604a338d2b
--- /dev/null
+++ b/FluentWeather/Helpers/HoverScrollBar.cs
@@ -0,0 +1,471 @@
+using System;
+using Windows.UI;
+using Windows.UI.Xaml;
+using Windows.UI.Xaml.Automation;
+using Windows.UI.Xaml.Controls;
+using Windows.UI.Xaml.Input;
+using Windows.UI.Xaml.Media;
+using Windows.UI.Xaml.Media.Animation;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build: the sideways scroll bar of the main page rows (saved locations, detail cards,
+    /// days and hours).
+    ///
+    /// The bar is hidden until the mouse is over the row or over the bar. It then fades in over
+    /// FadeInTime and shows a left arrow, a faint track and the thumb. It fades out over
+    /// FadeOutTime after the mouse leaves. The bar keeps the same thickness while it is visible.
+    ///
+    /// The bar is a small Grid that sits at the bottom of the row, in the same Grid cell as the
+    /// row. The space under the content of the row is reserved all the time, so the page does not
+    /// move when the bar appears. The content needs a bottom margin of BarHeight plus the gap.
+    /// The gap under the content is 6 points, so the bottom margin is 22.
+    ///
+    /// The default scroll bar of the row is hidden only after this bar is in place. When anything
+    /// fails here, the default scroll bar stays.
+    /// </summary>
+    public sealed class HoverScrollBar
+    {
+        public const double BarThickness = 5;
+        public const double ArrowSize = 16;
+        public const double BarHeight = ArrowSize;
+        public const double Gap = 6;
+        public static readonly TimeSpan FadeInTime = TimeSpan.FromMilliseconds(450);
+        public static readonly TimeSpan FadeOutTime = TimeSpan.FromMilliseconds(150);
+
+        private static readonly TimeSpan LeaveDelay = TimeSpan.FromMilliseconds(60);
+        private const double MinThumbWidth = 24;
+
+        private readonly FrameworkElement _host;
+        private readonly ScrollViewer _scroll;
+        private readonly double _stepWidth;
+        private readonly Action<int>? _step;
+
+        private readonly Grid _bar = new();
+        private readonly Grid _track = new();
+        private readonly Border _trackLine = new();
+        private readonly Grid _thumbHost = new();
+        private readonly Border _thumb = new();
+        private readonly Button _left = new();
+        private readonly Button _right = new();
+        private readonly SolidColorBrush _trackBrush = new();
+        private readonly SolidColorBrush _thumbBrush = new();
+        private readonly SolidColorBrush _arrowBrush = new();
+        private readonly SolidColorBrush _glyphBrush = new();
+        private readonly DispatcherTimer _leaveTimer = new() { Interval = LeaveDelay };
+
+        private Storyboard? _fade;
+        private bool _hostOver;
+        private bool _barOver;
+        private bool _dragging;
+        private bool _shown;
+        private double _dragStartX;
+        private double _dragStartOffset;
+
+        /// <summary>
+        /// Adds the bar to a row. The host is a ScrollViewer, or a control that has a ScrollViewer
+        /// inside, such as a ListView. A click on an arrow moves the row by stepWidth points, or
+        /// calls step when step is given (+1 to the right, -1 to the left).
+        /// </summary>
+        public static void Attach(FrameworkElement host, double stepWidth, Action<int>? step = null)
+        {
+            if (host == null)
+                return;
+
+            if (host.IsLoaded)
+            {
+                Create(host, stepWidth, step);
+                return;
+            }
+
+            RoutedEventHandler? onLoaded = null;
+            onLoaded = (_, _) =>
+            {
+                host.Loaded -= onLoaded;
+                Create(host, stepWidth, step);
+            };
+            host.Loaded += onLoaded;
+        }
+
+        private static void Create(FrameworkElement host, double stepWidth, Action<int>? step)
+        {
+            try
+            {
+                var scroll = host as ScrollViewer ?? FindScrollViewer(host);
+                if (scroll == null || host.Parent is not Grid parent)
+                    return;
+
+                var bar = new HoverScrollBar(host, scroll, stepWidth, step);
+                bar.Place(parent);
+            }
+            catch (Exception)
+            {
+                // The default scroll bar of the row stays when the new bar cannot be made.
+            }
+        }
+
+        private static ScrollViewer? FindScrollViewer(DependencyObject root)
+        {
+            var count = Windows.UI.Xaml.Media.VisualTreeHelper.GetChildrenCount(root);
+            for (var i = 0; i < count; i++)
+            {
+                var child = Windows.UI.Xaml.Media.VisualTreeHelper.GetChild(root, i);
+                if (child is ScrollViewer viewer)
+                    return viewer;
+
+                var found = FindScrollViewer(child);
+                if (found != null)
+                    return found;
+            }
+
+            return null;
+        }
+
+        private HoverScrollBar(FrameworkElement host, ScrollViewer scroll, double stepWidth, Action<int>? step)
+        {
+            _host = host;
+            _scroll = scroll;
+            _stepWidth = stepWidth;
+            _step = step;
+
+            _bar.Height = BarHeight;
+            _bar.VerticalAlignment = VerticalAlignment.Bottom;
+            _bar.HorizontalAlignment = HorizontalAlignment.Stretch;
+            _bar.ColumnSpacing = 6;
+            _bar.Opacity = 0;
+            _bar.IsHitTestVisible = false;
+            _bar.Visibility = Visibility.Collapsed;
+            _bar.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
+            _bar.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
+            _bar.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
+
+            // The track is as tall as the bar, so a click anywhere in that strip pages the row.
+            _track.Background = new SolidColorBrush(Colors.Transparent);
+            Grid.SetColumn(_track, 1);
+
+            _trackLine.Height = BarThickness;
+            _trackLine.VerticalAlignment = VerticalAlignment.Center;
+            _trackLine.CornerRadius = new CornerRadius(BarThickness / 2);
+            _trackLine.Background = _trackBrush;
+            _trackLine.IsHitTestVisible = false;
+
+            // The thumb is drawn BarThickness points tall. Its host is as tall as the bar, so the
+            // mouse can grab it easily.
+            _thumbHost.Background = new SolidColorBrush(Colors.Transparent);
+            _thumbHost.HorizontalAlignment = HorizontalAlignment.Left;
+            _thumbHost.Width = MinThumbWidth;
+
+            _thumb.Height = BarThickness;
+            _thumb.VerticalAlignment = VerticalAlignment.Center;
+            _thumb.CornerRadius = new CornerRadius(BarThickness / 2);
+            _thumb.Background = _thumbBrush;
+            _thumb.IsHitTestVisible = false;
+
+            _thumbHost.Children.Add(_thumb);
+            _track.Children.Add(_trackLine);
+            _track.Children.Add(_thumbHost);
+
+            ConfigureArrow(_left, "\uE76B", "ScrollBarLeftName", "Scroll left");
+            ConfigureArrow(_right, "\uE76C", "ScrollBarRightName", "Scroll right");
+            Grid.SetColumn(_left, 0);
+            Grid.SetColumn(_right, 2);
+
+            _bar.Children.Add(_left);
+            _bar.Children.Add(_track);
+            _bar.Children.Add(_right);
+
+            _leaveTimer.Tick += LeaveTimer_Tick;
+        }
+
+        private void ConfigureArrow(Button button, string glyph, string nameKey, string fallbackName)
+        {
+            button.Width = ArrowSize;
+            button.Height = ArrowSize;
+            button.MinWidth = 0;
+            button.MinHeight = 0;
+            button.Padding = new Thickness(0);
+            button.BorderThickness = new Thickness(0);
+            button.CornerRadius = new CornerRadius(4);
+            button.Background = _arrowBrush;
+            button.IsTabStop = false;
+            button.Content = new FontIcon
+            {
+                FontFamily = IconFont(),
+                Glyph = glyph,
+                FontSize = 10,
+                Foreground = _glyphBrush
+            };
+
+            var name = nameKey.GetLocalized();
+            AutomationProperties.SetName(button, string.IsNullOrEmpty(name) ? fallbackName : name);
+        }
+
+        private static FontFamily IconFont() =>
+            Application.Current.Resources.TryGetValue("FluentIcons", out var value) && value is FontFamily family
+                ? family
+                : new FontFamily("Segoe Fluent Icons");
+
+        private void Place(Grid parent)
+        {
+            Grid.SetRow(_bar, Grid.GetRow(_host));
+            Grid.SetColumn(_bar, Grid.GetColumn(_host));
+            Grid.SetRowSpan(_bar, Grid.GetRowSpan(_host));
+            Grid.SetColumnSpan(_bar, Grid.GetColumnSpan(_host));
+            _bar.Margin = new Thickness(_host.Margin.Left, 0, _host.Margin.Right, _host.Margin.Bottom);
+
+            ApplyTheme();
+            parent.Children.Add(_bar);
+
+            _host.PointerEntered += Host_PointerEntered;
+            _host.PointerExited += Host_PointerExited;
+            _bar.PointerEntered += Bar_PointerEntered;
+            _bar.PointerExited += Bar_PointerExited;
+            _host.ActualThemeChanged += (_, _) => ApplyTheme();
+            _host.RegisterPropertyChangedCallback(UIElement.VisibilityProperty, (_, _) => HostVisibilityChanged());
+
+            _scroll.ViewChanged += (_, _) => RefreshIfShown();
+            _scroll.SizeChanged += (_, _) => RefreshIfShown();
+            if (_scroll.Content is FrameworkElement content)
+                content.SizeChanged += (_, _) => RefreshIfShown();
+            _track.SizeChanged += (_, _) => RefreshIfShown();
+
+            _thumbHost.PointerPressed += Thumb_PointerPressed;
+            _thumbHost.PointerMoved += Thumb_PointerMoved;
+            _thumbHost.PointerReleased += Thumb_PointerReleased;
+            _thumbHost.PointerCanceled += Thumb_PointerReleased;
+            _thumbHost.PointerCaptureLost += Thumb_PointerReleased;
+            _track.PointerPressed += Track_PointerPressed;
+
+            _left.Click += (_, _) => Arrow(-1);
+            _right.Click += (_, _) => Arrow(1);
+
+            // Only now is the default scroll bar hidden. The row still scrolls with the wheel,
+            // the keys and touch.
+            ScrollViewer.SetHorizontalScrollBarVisibility(_host, ScrollBarVisibility.Hidden);
+        }
+
+        private void ApplyTheme()
+        {
+            var light = _host.ActualTheme == ElementTheme.Light;
+            var ink = light ? Colors.Black : Colors.White;
+            _thumbBrush.Color = Color.FromArgb(0x99, ink.R, ink.G, ink.B);
+            _trackBrush.Color = Color.FromArgb(0x24, ink.R, ink.G, ink.B);
+            _arrowBrush.Color = Color.FromArgb(0x24, ink.R, ink.G, ink.B);
+            _glyphBrush.Color = light ? Color.FromArgb(0xFF, 0x20, 0x20, 0x20) : Color.FromArgb(0xFF, 0xE1, 0xE4, 0xEE);
+        }
+
+        // Pointer state. The bar is a sibling of the row, so moving the mouse from the row onto the
+        // bar leaves the row first. The short delay keeps the bar from flickering at that moment.
+
+        private void Host_PointerEntered(object sender, PointerRoutedEventArgs e)
+        {
+            _hostOver = true;
+            HoverChanged();
+        }
+
+        private void Host_PointerExited(object sender, PointerRoutedEventArgs e)
+        {
+            _hostOver = false;
+            HoverChanged();
+        }
+
+        private void Bar_PointerEntered(object sender, PointerRoutedEventArgs e)
+        {
+            _barOver = true;
+            HoverChanged();
+        }
+
+        private void Bar_PointerExited(object sender, PointerRoutedEventArgs e)
+        {
+            _barOver = false;
+            HoverChanged();
+        }
+
+        private void HoverChanged()
+        {
+            _leaveTimer.Stop();
+            if (_hostOver || _barOver || _dragging)
+                Show();
+            else
+                _leaveTimer.Start();
+        }
+
+        private void LeaveTimer_Tick(object? sender, object e)
+        {
+            _leaveTimer.Stop();
+            if (!_hostOver && !_barOver && !_dragging)
+                Hide();
+        }
+
+        private void HostVisibilityChanged()
+        {
+            if (_host.Visibility == Visibility.Visible)
+                return;
+
+            // The row is gone. Drop the state, so the bar is not left open when the row returns.
+            _hostOver = false;
+            _barOver = false;
+            _dragging = false;
+            _leaveTimer.Stop();
+            _shown = false;
+            _fade?.Stop();
+            _bar.Opacity = 0;
+            _bar.IsHitTestVisible = false;
+            _bar.Visibility = Visibility.Collapsed;
+        }
+
+        private void Show()
+        {
+            Refresh();
+            if (_bar.Visibility != Visibility.Visible || _shown)
+                return;
+
+            _shown = true;
+            _bar.IsHitTestVisible = true;
+            FadeTo(1, FadeInTime);
+        }
+
+        private void Hide()
+        {
+            if (!_shown)
+                return;
+
+            _shown = false;
+            FadeTo(0, FadeOutTime);
+        }
+
+        private void FadeTo(double target, TimeSpan full)
+        {
+            // Stop() puts the local value back, so keep the value that is on screen now.
+            var current = _bar.Opacity;
+            _fade?.Stop();
+            _bar.Opacity = current;
+
+            var distance = Math.Abs(target - current);
+            if (distance < 0.01)
+            {
+                _bar.Opacity = target;
+                if (!_shown)
+                    _bar.IsHitTestVisible = false;
+                return;
+            }
+
+            var animation = new DoubleAnimation
+            {
+                From = current,
+                To = target,
+                Duration = new Duration(TimeSpan.FromMilliseconds(full.TotalMilliseconds * distance)),
+                EasingFunction = new CubicEase { EasingMode = EasingMode.EaseOut }
+            };
+            Storyboard.SetTarget(animation, _bar);
+            Storyboard.SetTargetProperty(animation, "Opacity");
+
+            var board = new Storyboard();
+            board.Children.Add(animation);
+            board.Completed += (_, _) =>
+            {
+                if (_fade == board && !_shown)
+                    _bar.IsHitTestVisible = false;
+            };
+            _fade = board;
+            board.Begin();
+        }
+
+        // Size and place of the thumb, and the state of the arrows.
+
+        private void RefreshIfShown()
+        {
+            if (_shown)
+                Refresh();
+        }
+
+        private void Refresh()
+        {
+            var scrollable = _scroll.ScrollableWidth;
+            var canScroll = _host.Visibility == Visibility.Visible && scrollable > 0.5;
+            _bar.Visibility = canScroll ? Visibility.Visible : Visibility.Collapsed;
+            if (!canScroll)
+                return;
+
+            var trackWidth = _track.ActualWidth;
+            if (trackWidth <= 0)
+            {
+                _bar.UpdateLayout();
+                trackWidth = _track.ActualWidth;
+            }
+
+            var extent = _scroll.ExtentWidth;
+            if (trackWidth <= 0 || extent <= 0)
+                return;
+
+            var width = Math.Min(trackWidth, Math.Max(MinThumbWidth, trackWidth * _scroll.ViewportWidth / extent));
+            var room = trackWidth - width;
+            var left = room * Math.Clamp(_scroll.HorizontalOffset / scrollable, 0, 1);
+            _thumbHost.Width = width;
+            _thumbHost.Margin = new Thickness(left, 0, 0, 0);
+
+            _left.Opacity = _scroll.HorizontalOffset <= 0.5 ? 0.35 : 1;
+            _right.Opacity = _scroll.HorizontalOffset >= scrollable - 0.5 ? 0.35 : 1;
+        }
+
+        // Arrows, a click on the track and a drag of the thumb.
+
+        private void Arrow(int direction)
+        {
+            if (_step != null)
+            {
+                _step(direction);
+                return;
+            }
+
+            var target = Math.Clamp(_scroll.HorizontalOffset + direction * _stepWidth, 0, _scroll.ScrollableWidth);
+            _scroll.ChangeView(target, null, null, false);
+        }
+
+        private void Track_PointerPressed(object sender, PointerRoutedEventArgs e)
+        {
+            var x = e.GetCurrentPoint(_track).Position.X;
+            var direction = x < _thumbHost.Margin.Left ? -1 : 1;
+            var target = Math.Clamp(_scroll.HorizontalOffset + direction * _scroll.ViewportWidth * 0.9, 0, _scroll.ScrollableWidth);
+            _scroll.ChangeView(target, null, null, false);
+            e.Handled = true;
+        }
+
+        private void Thumb_PointerPressed(object sender, PointerRoutedEventArgs e)
+        {
+            if (_scroll.ScrollableWidth <= 0.5 || !_thumbHost.CapturePointer(e.Pointer))
+                return;
+
+            _dragging = true;
+            _dragStartX = e.GetCurrentPoint(_track).Position.X;
+            _dragStartOffset = _scroll.HorizontalOffset;
+            e.Handled = true;
+        }
+
+        private void Thumb_PointerMoved(object sender, PointerRoutedEventArgs e)
+        {
+            if (!_dragging)
+                return;
+
+            var room = _track.ActualWidth - _thumbHost.ActualWidth;
+            if (room <= 0)
+                return;
+
+            var dx = e.GetCurrentPoint(_track).Position.X - _dragStartX;
+            var target = Math.Clamp(_dragStartOffset + dx * (_scroll.ScrollableWidth / room), 0, _scroll.ScrollableWidth);
+            _scroll.ChangeView(target, null, null, true);
+            e.Handled = true;
+        }
+
+        private void Thumb_PointerReleased(object sender, PointerRoutedEventArgs e)
+        {
+            if (!_dragging)
+                return;
+
+            _dragging = false;
+            _thumbHost.ReleasePointerCaptures();
+            HoverChanged();
+        }
+    }
+}
diff --git a/FluentWeather/Helpers/HoverTip.cs b/FluentWeather/Helpers/HoverTip.cs
new file mode 100644
index 0000000000000000000000000000000000000000..4fd23f893ebef093e95a93abf56138edb9aa7af1
--- /dev/null
+++ b/FluentWeather/Helpers/HoverTip.cs
@@ -0,0 +1,160 @@
+using System;
+using System.Runtime.CompilerServices;
+using Windows.Foundation;
+using Windows.UI;
+using Windows.UI.Xaml;
+using Windows.UI.Xaml.Controls;
+using Windows.UI.Xaml.Controls.Primitives;
+using Windows.UI.Xaml.Input;
+using Windows.UI.Xaml.Media;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build: the hover panel of the detail cards. It looks like the app's tooltips (the
+    /// ToolTip style in App.xaml: the grey to blue grey gradient, a thin light border, white text),
+    /// but it opens after ShowDelay. Windows does not let an app change the delay of a ToolTip.
+    /// The panel closes when the mouse leaves the card, on a click and when a drag starts.
+    /// </summary>
+    public static class HoverTip
+    {
+        public static readonly TimeSpan ShowDelay = TimeSpan.FromMilliseconds(1200);
+
+        private static readonly ConditionalWeakTable<UIElement, Entry> Entries = new();
+        private static Popup? _popup;
+        private static TextBlock? _text;
+        private static DispatcherTimer? _timer;
+        private static UIElement? _pending;
+
+        private sealed class Entry
+        {
+            public string Text = "";
+        }
+
+        /// <summary>Local build: the hover text of an element, or an empty string.</summary>
+        public static string Get(UIElement element) =>
+            Entries.TryGetValue(element, out var entry) ? entry.Text : "";
+
+        /// <summary>Sets or changes the hover text of an element.</summary>
+        public static void Set(UIElement element, string text)
+        {
+            if (Entries.TryGetValue(element, out var entry))
+            {
+                entry.Text = text;
+                if (_pending == element && _popup is { IsOpen: true } && _text != null)
+                    _text.Text = text;
+                return;
+            }
+
+            Entries.Add(element, new Entry { Text = text });
+            element.PointerEntered += OnPointerEntered;
+            element.PointerExited += OnPointerLeft;
+            element.PointerCanceled += OnPointerLeft;
+            element.PointerCaptureLost += OnPointerLeft;
+            element.PointerPressed += OnPointerLeft;
+            element.RightTapped += (_, _) => Hide();
+            element.DragStarting += (_, _) => Hide();
+        }
+
+        private static void OnPointerEntered(object sender, PointerRoutedEventArgs e)
+        {
+            if (sender is not UIElement element)
+                return;
+            Hide();
+            _pending = element;
+            if (_timer == null)
+            {
+                _timer = new DispatcherTimer { Interval = ShowDelay };
+                _timer.Tick += (_, _) =>
+                {
+                    _timer.Stop();
+                    if (_pending != null)
+                        Show(_pending);
+                };
+            }
+            _timer.Stop();
+            _timer.Start();
+        }
+
+        private static void OnPointerLeft(object sender, PointerRoutedEventArgs e)
+        {
+            if (sender is UIElement element && ReferenceEquals(element, _pending))
+                Hide();
+        }
+
+        public static void Hide()
+        {
+            _timer?.Stop();
+            _pending = null;
+            if (_popup != null)
+                _popup.IsOpen = false;
+        }
+
+        private static void EnsurePopup()
+        {
+            if (_popup != null)
+                return;
+
+            var background = new LinearGradientBrush { StartPoint = new Point(0, 0), EndPoint = new Point(0, 1) };
+            background.GradientStops.Add(new GradientStop { Color = Color.FromArgb(0xFF, 0x2B, 0x2B, 0x2D), Offset = 0 });
+            background.GradientStops.Add(new GradientStop { Color = Color.FromArgb(0xFF, 0x2B, 0x35, 0x47), Offset = 1 });
+
+            _text = new TextBlock
+            {
+                FontSize = 12,
+                TextWrapping = TextWrapping.Wrap,
+                Foreground = new SolidColorBrush(Colors.White)
+            };
+            var border = new Border
+            {
+                Background = background,
+                BorderBrush = new SolidColorBrush(Color.FromArgb(0x24, 0xFF, 0xFF, 0xFF)),
+                BorderThickness = new Thickness(1),
+                CornerRadius = new CornerRadius(4),
+                Padding = new Thickness(9, 6, 9, 8),
+                MaxWidth = 320,
+                RequestedTheme = ElementTheme.Dark,
+                Child = _text,
+                IsHitTestVisible = false
+            };
+            _popup = new Popup { Child = border, IsLightDismissEnabled = false, IsHitTestVisible = false };
+        }
+
+        private static void Show(UIElement element)
+        {
+            try
+            {
+                if (!Entries.TryGetValue(element, out var entry) || string.IsNullOrEmpty(entry.Text))
+                    return;
+                if (element is FrameworkElement { IsLoaded: false } || element.Visibility != Visibility.Visible)
+                    return;
+
+                EnsurePopup();
+                _text!.Text = entry.Text;
+
+                var root = Window.Current.Content as UIElement;
+                var bounds = Window.Current.Bounds;
+                var topLeft = element.TransformToVisual(root).TransformPoint(new Point(0, 0));
+                var size = element.RenderSize;
+
+                var border = (FrameworkElement) _popup!.Child;
+                border.Measure(new Size(320, double.PositiveInfinity));
+                var tip = border.DesiredSize;
+
+                // Below the card, or above it when there is no room below. Kept inside the window.
+                var x = Math.Max(4, Math.Min(topLeft.X, bounds.Width - tip.Width - 4));
+                var y = topLeft.Y + size.Height + 6;
+                if (y + tip.Height > bounds.Height - 4)
+                    y = Math.Max(4, topLeft.Y - tip.Height - 6);
+
+                _popup.HorizontalOffset = x;
+                _popup.VerticalOffset = y;
+                _popup.IsOpen = true;
+            }
+            catch (Exception)
+            {
+                // No hover panel this time.
+            }
+        }
+    }
+}
diff --git a/FluentWeather/Helpers/Loc.cs b/FluentWeather/Helpers/Loc.cs
new file mode 100644
index 0000000000000000000000000000000000000000..728726ef1b6a86f08dd8ac0fb8b6e0d3290364cc
--- /dev/null
+++ b/FluentWeather/Helpers/Loc.cs
@@ -0,0 +1,77 @@
+using System;
+using System.Globalization;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build (v55): texts from the string resources in the language of the app. The English text
+    /// of the code is the fallback, for a missing key or when the resources cannot be read.
+    /// </summary>
+    internal static class Loc
+    {
+        /// <summary>The text of the key, or the English text.</summary>
+        public static string Get(string key, string english)
+        {
+            try
+            {
+                var text = key.GetLocalized();
+                return string.IsNullOrEmpty(text) ? english : text;
+            }
+            catch (Exception)
+            {
+                return english;
+            }
+        }
+
+        /// <summary>The text of the key with the values filled in at {0}, {1} and so on.</summary>
+        public static string Format(string key, string english, params object?[] values)
+        {
+            var format = Get(key, english);
+            try
+            {
+                return string.Format(CultureInfo.CurrentCulture, format, values);
+            }
+            catch (FormatException)
+            {
+                return string.Format(CultureInfo.CurrentCulture, english, values);
+            }
+        }
+
+        /// <summary>The culture of the language the app shows, for day names. The culture of Windows is the fallback.</summary>
+        public static CultureInfo Culture
+        {
+            get
+            {
+                try
+                {
+                    var languages = Windows.Globalization.ApplicationLanguages.Languages;
+                    if (languages.Count > 0)
+                        return new CultureInfo(languages[0]);
+                }
+                catch (Exception)
+                {
+                    // The fallback applies.
+                }
+
+                return CultureInfo.CurrentUICulture;
+            }
+        }
+
+        /// <summary>True when the app shows English.</summary>
+        public static bool IsEnglish
+        {
+            get
+            {
+                try
+                {
+                    var languages = Windows.Globalization.ApplicationLanguages.Languages;
+                    return languages.Count == 0 || languages[0].StartsWith("en", StringComparison.OrdinalIgnoreCase);
+                }
+                catch (Exception)
+                {
+                    return true;
+                }
+            }
+        }
+    }
+}
diff --git a/FluentWeather/Helpers/MoonCards.cs b/FluentWeather/Helpers/MoonCards.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a68361ba83bb39c80d5d8f3d1f24d60779b90065
--- /dev/null
+++ b/FluentWeather/Helpers/MoonCards.cs
@@ -0,0 +1,222 @@
+using System;
+using System.Globalization;
+using Windows.Foundation;
+using Windows.Storage;
+using Windows.UI;
+using Windows.UI.Xaml;
+using Windows.UI.Xaml.Controls;
+using Windows.UI.Xaml.Media;
+using Windows.UI.Xaml.Shapes;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build: the moon row of the day buttons (v54). The row sits under the temperatures and
+    /// shows the moon with its lit part, the name of the phase and the lit percentage.
+    ///
+    /// A day button is 186 points wide (v55, 174 in v54). The width fits the app's own phase names in
+    /// all 33 languages on one line. A longer name from weather.com ends with an ellipsis, and the
+    /// hover text shows it in full. It is 100 high with the moon row and 70 high without it.
+    /// The moon button in the title of the daily forecast turns the row on and off. The choice is
+    /// kept in the local settings under "showMoonRow". The row is on by default.
+    ///
+    /// The moon is drawn here, so every phase has a picture, with the lit part cut to the exact
+    /// percentage. The days from weather.com, the Open-Meteo days and the recorded past days all
+    /// use the same code.
+    /// </summary>
+    internal static class MoonCards
+    {
+        /// <summary>The width of every day button, past days included. With 8 points between the buttons the row moves 194 points per button.</summary>
+        public const double CardWidth = 186;
+
+        public const double HeightWithMoon = 100;
+
+        public const double HeightWithoutMoon = 70;
+
+        public const string SettingKey = "showMoonRow";
+
+        /// <summary>The Tag of the element that holds the moon row, so the code can find it again.</summary>
+        public const string RowTag = "moon";
+
+        public static bool IsOn()
+        {
+            try
+            {
+                if (ApplicationData.Current.LocalSettings.Values.TryGetValue(SettingKey, out var stored) && stored is bool on)
+                    return on;
+            }
+            catch (Exception)
+            {
+                // The default applies.
+            }
+
+            return true;
+        }
+
+        public static void SetOn(bool on)
+        {
+            try
+            {
+                ApplicationData.Current.LocalSettings.Values[SettingKey] = on;
+            }
+            catch (Exception)
+            {
+                // The choice stays in force until the app closes.
+            }
+        }
+
+        /// <summary>For example "95% lit".</summary>
+        public static string LitText(int percent)
+        {
+            string format;
+            try
+            {
+                format = "MoonLitFormat".GetLocalized();
+            }
+            catch (Exception)
+            {
+                format = "";
+            }
+
+            if (string.IsNullOrEmpty(format) || !format.Contains("{0}"))
+                format = "{0}% lit";
+
+            return string.Format(CultureInfo.CurrentCulture, format, percent);
+        }
+
+        /// <summary>Shows or hides the moon row of a day button and sets the height of the button to match.</summary>
+        public static void SetRowVisible(Button button, bool visible)
+        {
+            button.Height = visible ? HeightWithMoon : HeightWithoutMoon;
+
+            if (button.Content is not Grid root)
+                return;
+
+            foreach (var child in root.Children)
+            {
+                if (child is FrameworkElement element && element.Tag is string tag && tag == RowTag)
+                    element.Visibility = visible ? Visibility.Visible : Visibility.Collapsed;
+            }
+        }
+
+        /// <summary>The row: the moon on the left, the name over the lit percentage on the right. A name that is too long is cut with an ellipsis.</summary>
+        public static Grid CreateRow(string name, int percent, bool waxing)
+        {
+            var row = new Grid
+            {
+                Tag = RowTag,
+                ColumnSpacing = 6,
+                Margin = new Thickness(0, 6, 0, 0),
+                HorizontalAlignment = HorizontalAlignment.Stretch
+            };
+            row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
+            row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
+
+            var icon = CreateIcon(percent, waxing);
+            Grid.SetColumn(icon, 0);
+            row.Children.Add(icon);
+
+            var text = new StackPanel { VerticalAlignment = VerticalAlignment.Center };
+            text.Children.Add(new TextBlock
+            {
+                Text = name,
+                FontSize = 11,
+                MaxLines = 1,
+                TextTrimming = TextTrimming.CharacterEllipsis
+            });
+            text.Children.Add(new TextBlock
+            {
+                Text = LitText(percent),
+                FontSize = 11,
+                MaxLines = 1,
+                Opacity = 0.8,
+                TextTrimming = TextTrimming.CharacterEllipsis
+            });
+            Grid.SetColumn(text, 1);
+            row.Children.Add(text);
+
+            return row;
+        }
+
+        // The moon is a disc of 18 points with an outline. The lit part is drawn over it. The
+        // colors work on the dark and on the light card.
+
+        private const double Center = 10;
+        private const double Radius = 8.5;
+
+        private static FrameworkElement CreateIcon(int percent, bool waxing)
+        {
+            var canvas = new Canvas { Width = 20, Height = 20 };
+
+            var disc = new Ellipse
+            {
+                Width = 18,
+                Height = 18,
+                Fill = new SolidColorBrush(Color.FromArgb(0xFF, 0x5B, 0x62, 0x77)),
+                Stroke = new SolidColorBrush(Color.FromArgb(0xFF, 0x9A, 0xA1, 0xB5)),
+                StrokeThickness = 1
+            };
+            Canvas.SetLeft(disc, 1);
+            Canvas.SetTop(disc, 1);
+            canvas.Children.Add(disc);
+
+            var lit = LitGeometry(percent, waxing);
+            if (lit != null)
+                canvas.Children.Add(new Path { Data = lit, Fill = new SolidColorBrush(Color.FromArgb(0xFF, 0xF2, 0xE3, 0xA8)) });
+
+            return new Viewbox
+            {
+                Width = 22,
+                Height = 22,
+                VerticalAlignment = VerticalAlignment.Center,
+                Child = canvas
+            };
+        }
+
+        /// <summary>
+        /// The lit part of the disc. A waxing moon is lit on the right and a waning moon on the left,
+        /// as seen from the northern hemisphere. The edge of the disc is half of a circle. The other
+        /// edge, the terminator, is half of an ellipse. It bulges toward the dark side for a
+        /// crescent and toward the lit side for a gibbous moon.
+        /// </summary>
+        private static Geometry? LitGeometry(int percent, bool waxing)
+        {
+            var fraction = percent / 100.0;
+            if (fraction < 0.02)
+                return null;
+
+            if (fraction > 0.99)
+                return new EllipseGeometry { Center = new Point(Center, Center), RadiusX = Radius, RadiusY = Radius };
+
+            var radiusX = Math.Max(0.01, Math.Abs(1 - 2 * fraction) * Radius);
+            var gibbous = fraction > 0.5;
+            var edge = waxing ? SweepDirection.Clockwise : SweepDirection.Counterclockwise;
+            var terminator = waxing == gibbous ? SweepDirection.Clockwise : SweepDirection.Counterclockwise;
+
+            var figure = new PathFigure
+            {
+                StartPoint = new Point(Center, Center - Radius),
+                IsClosed = true,
+                IsFilled = true
+            };
+            figure.Segments.Add(new ArcSegment
+            {
+                Point = new Point(Center, Center + Radius),
+                Size = new Size(Radius, Radius),
+                SweepDirection = edge,
+                IsLargeArc = false
+            });
+            figure.Segments.Add(new ArcSegment
+            {
+                Point = new Point(Center, Center - Radius),
+                Size = new Size(radiusX, Radius),
+                SweepDirection = terminator,
+                IsLargeArc = false
+            });
+
+            var geometry = new PathGeometry();
+            geometry.Figures.Add(figure);
+            return geometry;
+        }
+    }
+}
diff --git a/FluentWeather/Helpers/MoonMath.cs b/FluentWeather/Helpers/MoonMath.cs
new file mode 100644
index 0000000000000000000000000000000000000000..1811ce6518db318541b9b80ab406c7eea0d122a7
--- /dev/null
+++ b/FluentWeather/Helpers/MoonMath.cs
@@ -0,0 +1,135 @@
+using System;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build: the phase of the moon on a given day, for the moon row of the day buttons.
+    ///
+    /// weather.com sends the name of the phase of each forecast day but no percentage of the
+    /// lit part. So the app computes it. The calculation uses the mean length of the lunar cycle
+    /// (29.530588853 days) from a known new moon (2000-01-06 18:14 UTC). The lit part follows
+    /// from the age of the moon with (1 - cos(2 * pi * age / cycle)) / 2. The true phase differs
+    /// from this mean phase by a few percent. The tray program uses the same method.
+    ///
+    /// The age is taken at noon of the local day, so a day shows the phase of its middle.
+    /// </summary>
+    internal static class MoonMath
+    {
+        private const double Synodic = 29.530588853;
+
+        private static readonly DateTime KnownNewMoon = new(2000, 1, 6, 18, 14, 0, DateTimeKind.Utc);
+
+        /// <summary>Days since the last new moon, 0 up to 29.53.</summary>
+        public static double Age(DateTime utc)
+        {
+            var days = (utc - KnownNewMoon).TotalDays % Synodic;
+            return days < 0 ? days + Synodic : days;
+        }
+
+        /// <summary>The age of the moon at noon of the local day. Only the date and the offset of the value count.</summary>
+        public static double AgeAtLocalNoon(DateTimeOffset day)
+        {
+            var noon = new DateTimeOffset(day.Year, day.Month, day.Day, 12, 0, 0, day.Offset);
+            return Age(noon.UtcDateTime);
+        }
+
+        /// <summary>True from new moon to full moon, when the lit part grows.</summary>
+        public static bool IsWaxing(double age) => age < Synodic / 2;
+
+        /// <summary>The lit part of the disc, 0 to 100.</summary>
+        public static int LitPercent(double age)
+        {
+            var lit = (1 - Math.Cos(2 * Math.PI * age / Synodic)) / 2;
+            return (int) Math.Round(lit * 100, MidpointRounding.AwayFromZero);
+        }
+
+        /// <summary>
+        /// The phase code in the form of weather.com: N new moon, WXC waxing crescent, FQ first quarter,
+        /// WXG waxing gibbous, F full moon, WNG waning gibbous, LQ last quarter and WNC waning crescent.
+        /// </summary>
+        public static string PhaseCode(double age) => age switch
+        {
+            < 0.5 => "N",
+            < 6.4 => "WXC",
+            < 8.4 => "FQ",
+            < 13.8 => "WXG",
+            < 15.8 => "F",
+            < 21.1 => "WNG",
+            < 23.1 => "LQ",
+            < 28.5 => "WNC",
+            _ => "N"
+        };
+
+        /// <summary>True for the eight phase codes that weather.com and the Open-Meteo data source use.</summary>
+        public static bool IsPhaseCode(string? code) => code is "N" or "WXC" or "FQ" or "WXG" or "F" or "WNG" or "LQ" or "WNC";
+
+        /// <summary>
+        /// The phase code to show for a day. It is the code from the weather data when that code is
+        /// valid, and the computed code of the given moon age otherwise.
+        /// </summary>
+        public static string CodeOrComputed(string? code, double age)
+        {
+            var trimmed = code?.Trim();
+            return IsPhaseCode(trimmed) ? trimmed! : PhaseCode(age);
+        }
+
+        /// <summary>The names that weather.com sends in English.</summary>
+        private static readonly string[] EnglishNames =
+        {
+            "New Moon", "Waxing Crescent", "First Quarter", "Waxing Gibbous",
+            "Full Moon", "Waning Gibbous", "Last Quarter", "Waning Crescent"
+        };
+
+        /// <summary>
+        /// The phase name to show for a forecast day (v55). weather.com's own name is used when it is
+        /// in the language of the app. When the day has no name, or weather.com sent the English name
+        /// while the app shows another language, the app's own name of the phase is used. The Open-Meteo
+        /// data source writes the app's own names, so they pass through unchanged.
+        /// </summary>
+        public static string DisplayName(string? sourceName, string? code, double age)
+        {
+            var name = sourceName?.Trim();
+            if (!string.IsNullOrEmpty(name))
+            {
+                var english = Array.Exists(EnglishNames, n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase));
+                if (!english || Loc.IsEnglish)
+                    return name!;
+            }
+
+            return PhaseName(CodeOrComputed(code, age));
+        }
+
+        /// <summary>
+        /// The name of a phase from the string resources, in the language of the app. The 33 languages
+        /// of the app all have the eight names. The Open-Meteo data source and the recorded past days use
+        /// these names. Forecast days from weather.com use them when weather.com has no name in the
+        /// language of the app (see DisplayName). English is the fallback.
+        /// </summary>
+        public static string PhaseName(string code)
+        {
+            var (key, english) = code switch
+            {
+                "WXC" => ("MoonPhaseWaxingCrescent", "Waxing Crescent"),
+                "FQ" => ("MoonPhaseFirstQuarter", "First Quarter"),
+                "WXG" => ("MoonPhaseWaxingGibbous", "Waxing Gibbous"),
+                "F" => ("MoonPhaseFull", "Full Moon"),
+                "WNG" => ("MoonPhaseWaningGibbous", "Waning Gibbous"),
+                "LQ" => ("MoonPhaseLastQuarter", "Last Quarter"),
+                "WNC" => ("MoonPhaseWaningCrescent", "Waning Crescent"),
+                _ => ("MoonPhaseNew", "New Moon")
+            };
+
+            string text;
+            try
+            {
+                text = key.GetLocalized();
+            }
+            catch (Exception)
+            {
+                text = "";
+            }
+
+            return string.IsNullOrWhiteSpace(text) ? english : text;
+        }
+    }
+}
diff --git a/FluentWeather/Helpers/TitleShadow.cs b/FluentWeather/Helpers/TitleShadow.cs
new file mode 100644
index 0000000000000000000000000000000000000000..873ae8f19da95bdb9b4365ec52b36a6db5004b40
--- /dev/null
+++ b/FluentWeather/Helpers/TitleShadow.cs
@@ -0,0 +1,99 @@
+using System;
+using System.Numerics;
+using Windows.UI;
+using Windows.UI.Composition;
+using Windows.UI.Xaml;
+using Windows.UI.Xaml.Controls;
+using Windows.UI.Xaml.Hosting;
+using Windows.UI.Xaml.Shapes;
+using FluentWeather.Services;
+
+namespace FluentWeather.Helpers
+{
+    /// <summary>
+    /// Local build: a soft drop shadow under the text of a title, such as "Daily forecast".
+    ///
+    /// XAML has no text shadow. The shadow is a composition DropShadow that uses the shape of the
+    /// text (its alpha mask). It is drawn in an empty element that sits behind every other child of
+    /// the parent of the title, and it follows the place and the size of the title.
+    /// </summary>
+    public static class TitleShadow
+    {
+        private const float BlurRadius = 4f;
+        private const float Opacity = 0.65f;
+        private static readonly Vector3 Offset = new(0, 2, 0);
+
+        public static void Attach(TextBlock title)
+        {
+            if (title == null)
+                return;
+            if (title.IsLoaded)
+                Add(title);
+            else
+                title.Loaded += Title_Loaded;
+        }
+
+        private static void Title_Loaded(object sender, RoutedEventArgs e)
+        {
+            var title = (TextBlock) sender;
+            title.Loaded -= Title_Loaded;
+            Add(title);
+        }
+
+        private static void Add(TextBlock title)
+        {
+            try
+            {
+                if (title.Parent is not Panel parent || parent is StackPanel)
+                    return;
+
+                // An empty element at the top left corner of the parent, behind the other children.
+                var host = new Rectangle
+                {
+                    Width = 0,
+                    Height = 0,
+                    IsHitTestVisible = false,
+                    HorizontalAlignment = HorizontalAlignment.Left,
+                    VerticalAlignment = VerticalAlignment.Top
+                };
+                parent.Children.Insert(0, host);
+
+                var compositor = ElementCompositionPreview.GetElementVisual(host).Compositor;
+                var shadow = compositor.CreateDropShadow();
+                shadow.BlurRadius = BlurRadius;
+                shadow.Opacity = Opacity;
+                shadow.Color = Colors.Black;
+                shadow.Offset = Offset;
+                shadow.Mask = title.GetAlphaMask();
+
+                var sprite = compositor.CreateSpriteVisual();
+                sprite.Shadow = shadow;
+                ElementCompositionPreview.SetElementChildVisual(host, sprite);
+
+                void Place()
+                {
+                    try
+                    {
+                        var at = title.TransformToVisual(host).TransformPoint(new Windows.Foundation.Point(0, 0));
+                        sprite.Offset = new Vector3((float) at.X, (float) at.Y, 0);
+                        sprite.Size = new Vector2((float) title.ActualWidth, (float) title.ActualHeight);
+                        sprite.IsVisible = title.Visibility == Visibility.Visible && title.ActualWidth > 0;
+                    }
+                    catch (Exception)
+                    {
+                        // The title is not in the visual tree at this moment.
+                    }
+                }
+
+                // The title can move when the window or a neighbor changes size, and it can change
+                // its text. The place is checked after each layout pass.
+                title.LayoutUpdated += (_, _) => Place();
+                Place();
+            }
+            catch (Exception ex)
+            {
+                CrashLog.Write(ex, "TitleShadow");
+            }
+        }
+    }
+}
