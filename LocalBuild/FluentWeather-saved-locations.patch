+                    daily.sunsetTimeUtc.Add(sunset == null ? null : Utc(sunset.Value));
+                    daily.temperatureMax.Add(max);
+                    daily.temperatureMin.Add(min ?? 0);
+                    daily.validTimeLocal.Add(Offset(date.AddHours(7)));
