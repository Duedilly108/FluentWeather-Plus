+
+        private static bool TryParseExtraTag(string? tag, out ExtraFeed feed, out bool tray)
+        {
+            feed = ExtraFeed.Marine;
+            tray = false;
+            var parts = tag?.Split('.');
+            if (parts == null || parts.Length != 2 || !Enum.TryParse(parts[0], out feed))
+                return false;
+            tray = parts[1] == "tray";
+            return true;
+        }
