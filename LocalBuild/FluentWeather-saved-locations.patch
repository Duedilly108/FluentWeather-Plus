diff --git a/FluentWeather/Services/TrayRefreshService.cs b/FluentWeather/Services/TrayRefreshService.cs
new file mode 100644
index 0000000000000000000000000000000000000000..418740c8142516b859301a66e4f3c936978815f5
--- /dev/null
+++ b/FluentWeather/Services/TrayRefreshService.cs
@@ -0,0 +1,70 @@
+using System;
+using System.Threading.Tasks;
+using Windows.ApplicationModel.AppService;
+using Windows.ApplicationModel.Background;
+using Windows.Foundation.Collections;
+
+namespace FluentWeather.Services
+{
+    /// <summary>
+    /// Local build: the "FluentWeatherTrayRefresh" app service. The tray helper calls it every
+    /// 5 minutes while the app window is closed or minimized. Windows runs it inside the app without
+    /// opening a window. It downloads the current conditions for the app's location and every saved
+    /// location, and writes the tray files. The app service is declared in the package manifest by
+    /// the local build script.
+    /// </summary>
+    internal static class TrayRefreshService
+    {
+        public const string ServiceName = "FluentWeatherTrayRefresh";
+
+        public static bool CanHandle(IBackgroundTaskInstance taskInstance)
+        {
+            return taskInstance?.TriggerDetails is AppServiceTriggerDetails details &&
+                   string.Equals(details.Name, ServiceName, StringComparison.Ordinal);
+        }
+
+        public static void Handle(IBackgroundTaskInstance taskInstance)
+        {
+            var details = (AppServiceTriggerDetails) taskInstance.TriggerDetails;
+            var deferral = taskInstance.GetDeferral();
+            var completed = false;
+
+            void Complete()
+            {
+                if (completed) return;
+                completed = true;
+                deferral.Complete();
+            }
+
+            taskInstance.Canceled += (_, _) => Complete();
+            details.AppServiceConnection.ServiceClosed += (_, _) => Complete();
+            details.AppServiceConnection.RequestReceived += async (_, args) =>
+            {
+                var messageDeferral = args.GetDeferral();
+                var result = "ok";
+                try
+                {
+                    await Task.WhenAll(TrayWeatherFile.RefreshCurrentAsync(), TrayWeatherFile.RefreshAllSavedAsync(true));
+                }
+                catch (Exception)
+                {
+                    result = "failed";
+                }
+
+                try
+                {
+                    await args.Request.SendResponseAsync(new ValueSet { ["result"] = result });
+                }
+                catch (Exception)
+                {
+                    // The tray closed the connection. Nothing else to do.
+                }
+                finally
+                {
+                    messageDeferral.Complete();
+                    Complete();
+                }
+            };
+        }
+    }
+}
diff --git a/FluentWeather/Services/TrayWeatherFile.cs b/FluentWeather/Services/TrayWeatherFile.cs
new file mode 100644
index 0000000000000000000000000000000000000000..412714b28534ab6939fe2e124d75340940c05a73
--- /dev/null
+++ b/FluentWeather/Services/TrayWeatherFile.cs
@@ -0,0 +1,434 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using FluentWeather.Helpers;
+using FluentWeather.Models;
+using FluentWeather.Utils;
+using Windows.Storage;
+
+namespace FluentWeather.Services
+{
+    /// <summary>
+    /// Writes current conditions for the FluentWeather tray helper, so the tray helper itself
+    /// never needs internet access. Two files in LocalState, UTF-8, one "key=value" per line:
+    ///
+    ///   tray-weather.txt       the location shown in the app
+    ///   tray-weather-all.txt   every saved location, each block starting with "[placeId]"
+    ///
+    /// Lines starting with "d." are ready-to-show details for the tray's hover panel,
+    /// for example "d.Humidity=96%". The tray lets the user choose which ones to show.
+    ///
+    /// Both are written by the app after loading data, and by the live tile background task,
+    /// which runs about every 15 minutes even when the app is closed.
+    /// </summary>
+    internal static class TrayWeatherFile
+    {
+        private const string CurrentFileName = "tray-weather.txt";
+        private const string AllFileName = "tray-weather-all.txt";
+
+        // Do not refresh all saved locations more often than this, unless the list changed.
+        private static readonly TimeSpan AllRefreshInterval = TimeSpan.FromMinutes(10);
+        private const int MaxParallelRequests = 4;
+
+        private static readonly SemaphoreSlim WriteLock = new(1, 1);
+        private static readonly SemaphoreSlim AllLock = new(1, 1);
+        private static DateTimeOffset _lastAllRefresh = DateTimeOffset.MinValue;
+
+        /// <summary>Writes the location shown in the app.</summary>
+        public static async Task TryWriteAsync(RootV3Response data)
+        {
+            try
+            {
+                var units = await VariousUtils.GetUnitsCode();
+                var daily = data.v3wxforecastdaily10day;
+                var point = data.v3locationpoint?.LocationV3;
+                if (point != null)
+                    OpenMeteoExtrasService.RememberWeatherComPollen(point.latitude, point.longitude,
+                        data.v2idxPollenDaypart10days?.PollenForecastDaypart);
+                var text = await FormatBlockAsync(data.v3wxobservationscurrent, data.v3locationpoint.LocationV3, units,
+                    daily?.moonriseTimeLocal, daily?.moonsetTimeLocal);
+                await WriteFileAsync(CurrentFileName, text);
+            }
+            catch (Exception)
+            {
+                // The tray display is optional. A failed write must never affect the app or the live tile.
+            }
+        }
+
+        /// <summary>
+        /// Fetches the current conditions of the location shown in the app (the "lastPlaceId" setting)
+        /// with the small request, and writes tray-weather.txt. Used by the tray's 5-minute refresh.
+        /// </summary>
+        public static async Task RefreshCurrentAsync()
+        {
+            try
+            {
+                var placeId = await ApplicationData.Current.LocalSettings.ReadAsync<string>("lastPlaceId");
+                if (string.IsNullOrEmpty(placeId))
+                    return;
+
+                var response = await ApiUtils.GetCurrentConditions(placeId);
+                var json = await response.Content.ReadAsStringAsync();
+                var data = System.Text.Json.JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.CurrentConditionsResponse);
+                if (data?.v3wxobservationscurrent == null || data.v3locationpoint?.LocationV3 == null)
+                    return;
+
+                var units = await VariousUtils.GetUnitsCode();
+                var text = await FormatBlockAsync(data.v3wxobservationscurrent, data.v3locationpoint.LocationV3, units,
+                    data.v3wxforecastdaily3day?.moonriseTimeLocal, data.v3wxforecastdaily3day?.moonsetTimeLocal);
+                await WriteFileAsync(CurrentFileName, text);
+            }
+            catch (Exception)
+            {
+                // The tray keeps its last data. The next refresh tries again.
+            }
+        }
+
+        /// <summary>
+        /// Fetches current conditions for every saved location and writes tray-weather-all.txt.
+        /// A location whose request fails keeps its previous data.
+        /// </summary>
+        public static async Task RefreshAllSavedAsync(bool force)
+        {
+            if (!await AllLock.WaitAsync(0))
+                return; // a refresh is already running
+            try
+            {
+                if (!force && DateTimeOffset.UtcNow - _lastAllRefresh < AllRefreshInterval)
+                    return;
+
+                var saved = await SavedLocationsService.GetAllAsync();
+                var previous = await ReadPreviousBlocksAsync();
+                var units = await VariousUtils.GetUnitsCode();
+
+                using var throttle = new SemaphoreSlim(MaxParallelRequests);
+                var tasks = saved.Select(async location =>
+                {
+                    await throttle.WaitAsync();
+                    try
+                    {
+                        var response = await ApiUtils.GetCurrentConditions(location.PlaceId);
+                        var json = await response.Content.ReadAsStringAsync();
+                        var data = System.Text.Json.JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.CurrentConditionsResponse);
+                        if (data?.v3wxobservationscurrent == null || data.v3locationpoint?.LocationV3 == null)
+                            return previous.TryGetValue(location.PlaceId, out var old) ? old : null;
+
+                        OpenMeteoExtrasService.RememberWeatherComPollen(data.v3locationpoint.LocationV3.latitude,
+                            data.v3locationpoint.LocationV3.longitude, data.pollen?.Forecast);
+
+                        // "Past days": the data is here anyway, so it also updates today's record.
+                        var part = data.v3wxforecastdaily3day?.daypart?.FirstOrDefault();
+                        await PastDaysService.ObserveAsync(location.PlaceId, data.v3wxobservationscurrent,
+                            part?.iconCode, part?.wxPhraseLong, part?.precipChance, units.ToString());
+
+                        return "[" + location.PlaceId + "]\n" +
+                               await FormatBlockAsync(data.v3wxobservationscurrent, data.v3locationpoint.LocationV3, units,
+                                   data.v3wxforecastdaily3day?.moonriseTimeLocal, data.v3wxforecastdaily3day?.moonsetTimeLocal);
+                    }
+                    catch (Exception)
+                    {
+                        return previous.TryGetValue(location.PlaceId, out var old) ? old : null;
+                    }
+                    finally
+                    {
+                        throttle.Release();
+                    }
+                }).ToList();
+
+                var blocks = await Task.WhenAll(tasks);
+                var text = string.Join("\n", blocks.Where(b => !string.IsNullOrEmpty(b)));
+                await WriteFileAsync(AllFileName, text);
+                _lastAllRefresh = DateTimeOffset.UtcNow;
+            }
+            catch (Exception)
+            {
+                // Optional feature. Try again at the next refresh.
+            }
+            finally
+            {
+                AllLock.Release();
+            }
+        }
+
+        // The nearest official weather station does not change, so it is looked up once per
+        // location and kept in the app settings for this long.
+        private static readonly TimeSpan StationCacheAge = TimeSpan.FromDays(30);
+
+        // "d.Station=Fairfield (KFFL), 3.7 mi", or an empty string when it cannot be found.
+        private static async Task<string> FormatStationAsync(LocationV3 loc, WetUnits units)
+        {
+            try
+            {
+                var key = "nearStation|" + loc.latitude.ToString("0.00", CultureInfo.InvariantCulture) + ","
+                          + loc.longitude.ToString("0.00", CultureInfo.InvariantCulture);
+                var settings = ApplicationData.Current.LocalSettings.Values;
+                var parts = (settings.TryGetValue(key, out var stored) ? stored as string : null)?.Split('|');
+
+                var fresh = parts is { Length: 5 }
+                            && long.TryParse(parts[4], NumberStyles.Integer, CultureInfo.InvariantCulture, out var ticks)
+                            && DateTime.UtcNow - new DateTime(ticks, DateTimeKind.Utc) < StationCacheAge;
+                if (!fresh)
+                {
+                    var found = await ApiUtils.GetNearestStation(loc.latitude, loc.longitude);
+                    if (found != null)
+                    {
+                        parts = found.Select(x => x.Replace('|', '/')).Append(DateTime.UtcNow.Ticks.ToString(CultureInfo.InvariantCulture)).ToArray();
+                        settings[key] = string.Join("|", parts);
+                    }
+                }
+
+                if (parts is not { Length: 5 })
+                    return string.Empty;
+
+                var distance = units is WetUnits.e or WetUnits.h ? parts[3] + " mi" : parts[2] + " km";
+                return "d.Station=" + OneLine(parts[0] + " (" + parts[1] + "), " + distance) + "\n";
+            }
+            catch (Exception)
+            {
+                // The station line is optional.
+                return string.Empty;
+            }
+        }
+
+        private static async Task<string> FormatBlockAsync(V3WxObservationsCurrent obs, LocationV3 loc, WetUnits units,
+            List<DateTimeOffset?>? moonrises = null, List<DateTimeOffset?>? moonsets = null)
+        {
+            var place = new[] { loc.displayName, loc.city }.FirstOrDefault(s => !string.IsNullOrEmpty(s)) ?? string.Empty;
+            var fullPlace = string.Join(", ", new[] { loc.displayName, loc.adminDistrict, loc.country }
+                .Where(s => !string.IsNullOrEmpty(s)).Distinct());
+
+            return new StringBuilder()
+                .Append("place=").Append(OneLine(place)).Append('\n')
+                .Append("fullplace=").Append(OneLine(fullPlace)).Append('\n')
+                .Append("temp=").Append(obs.temperature).Append('\n')
+                .Append("feels=").Append(obs.temperatureFeelsLike).Append('\n')
+                .Append("unit=").Append(MeasureUnitUtils.GetTemperatureUnits(units)).Append('\n')
+                .Append("icon=").Append(obs.iconCode).Append('\n')
+                // "D" or "N". weather.com sends the same "Cloudy" code by day and by night, so the tray
+                // needs this to show the moon behind the cloud at night.
+                .Append("daynight=").Append(OneLine(obs.dayOrNight ?? string.Empty)).Append('\n')
+                // The tray draws the moon as it looks from this latitude (lit side mirrored south of the equator).
+                .Append("lat=").Append(loc.latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append('\n')
+                .Append("phrase=").Append(OneLine(obs.wxPhraseLong ?? obs.cloudCoverPhrase)).Append('\n')
+                .Append("observed=").Append(obs.validTimeLocal.ToString("o")).Append('\n')
+                .Append("written=").Append(DateTimeOffset.UtcNow.ToString("o")).Append('\n')
+                .Append(await FormatDetailsAsync(obs, units))
+                .Append(await FormatMoonTimeAsync("Moonrise", moonrises))
+                .Append(await FormatMoonTimeAsync("Moonset", moonsets))
+                .Append(await FormatStationAsync(loc, units))
+                .Append(await FormatWaterAsync(loc, obs, units))
+                .Append(await FormatExtrasAsync(loc, units))
+                .ToString();
+        }
+
+        // Local build: the extra Open-Meteo lines, "d.ExtraMarine=1.2 m 14 s, sea 74F" and so on,
+        // for each feed whose "Tray" box is ticked in the app settings. See OpenMeteoExtrasService.
+        private static async Task<string> FormatExtrasAsync(LocationV3 loc, WetUnits units)
+        {
+            var sb = new StringBuilder();
+            foreach (var feed in OpenMeteoExtrasService.AllFeeds)
+            {
+                try
+                {
+                    if (!await OpenMeteoExtrasService.IsOnAsync(feed, true))
+                        continue;
+                    var text = await OpenMeteoExtrasService.DescribeAsync(feed, loc.latitude, loc.longitude, units);
+                    if (text != null)
+                        sb.Append("d.Extra").Append(feed).Append('=').Append(OneLine(text.Value.TrayLine)).Append('\n');
+                }
+                catch (Exception)
+                {
+                    // The line is left out.
+                }
+            }
+
+            return sb.ToString();
+        }
+
+        // Local build: "d.WaterTemp=56°F, Des Moines River at Keosauqua, 19 mi" and
+        // "d.WaterWind=12 mph N" for the tray hover panel, when the "Nearby water" tray setting is on.
+        // The wind is the station's own wind when it has one, otherwise the location's current wind.
+        private static async Task<string> FormatWaterAsync(LocationV3 loc, V3WxObservationsCurrent obs, WetUnits units)
+        {
+            try
+            {
+                if (!await WaterService.IsTrayEnabledAsync())
+                    return string.Empty;
+
+                var reading = await WaterService.GetNearestAsync(loc.latitude, loc.longitude);
+                if (reading == null)
+                    return string.Empty;
+
+                var degrees = "\u00B0" + MeasureUnitUtils.GetTemperatureUnits(units);
+                var temp = WaterService.TemperatureFor(reading.WaterTemperatureC, units) + degrees + ", " +
+                           reading.StationName + ", " + WaterService.DistanceFor(reading.DistanceKm, units);
+                // The station's own wind, otherwise the Open-Meteo wind and gusts of the location,
+                // otherwise the weather.com wind.
+                string wind;
+                if (reading.WindSpeedKmh != null)
+                {
+                    wind = OpenMeteoExtrasService.Wind(reading.WindSpeedKmh.Value, units) +
+                           (string.IsNullOrEmpty(reading.WindDirection) ? "" : " " + reading.WindDirection) +
+                           (reading.WindGustKmh != null ? ", " + string.Format(CultureInfo.CurrentCulture, "WaterGust".GetLocalized(),
+                               OpenMeteoExtrasService.Wind(reading.WindGustKmh.Value, units)) : "");
+                }
+                else
+                {
+                    var model = await OpenMeteoExtrasService.GetWindAsync(loc.latitude, loc.longitude);
+                    wind = model?.SpeedKmh != null
+                        ? OpenMeteoExtrasService.Wind(model.SpeedKmh.Value, units) + OpenMeteoExtrasService.Direction(model.Direction) +
+                          (model.GustKmh != null ? ", " + string.Format(CultureInfo.CurrentCulture, "WaterGust".GetLocalized(),
+                              OpenMeteoExtrasService.Wind(model.GustKmh.Value, units)) : "") + " (" + "WaterWindForecastShort".GetLocalized() + ")"
+                        : obs.windSpeed + " " + MeasureUnitUtils.GetWindSpeedUnits(units) + " " + obs.windDirectionCardinal + " (" +
+                          "WaterWindForecastShort".GetLocalized() + ")";
+                }
+
+                return "d.WaterTemp=" + OneLine(temp) + "\n" + "d.WaterWind=" + OneLine(wind) + "\n";
+            }
+            catch (Exception)
+            {
+                return string.Empty;
+            }
+        }
+
+        // Every current-conditions value the service provides, as display text in the user's units.
+        private static async Task<string> FormatDetailsAsync(V3WxObservationsCurrent obs, WetUnits units)
+        {
+            var c = CultureInfo.CurrentCulture;
+            var deg = "\u00B0" + MeasureUnitUtils.GetTemperatureUnits(units);
+            var imperial = units == WetUnits.e;
+            var rain = MeasureUnitUtils.GetLiquidPrecipitationUnits(units);
+            var snow = MeasureUnitUtils.GetSnowPrecipitationUnits(units);
+            var sb = new StringBuilder();
+
+            void Add(string key, string? value)
+            {
+                if (!string.IsNullOrWhiteSpace(value))
+                    sb.Append("d.").Append(key).Append('=').Append(OneLine(value)).Append('\n');
+            }
+
+            string Num(double v) => v.ToString("0.##", c);
+
+            Add("Conditions", obs.wxPhraseLong ?? obs.cloudCoverPhrase);
+            Add("Temperature", obs.temperature + deg);
+            Add("FeelsLike", obs.temperatureFeelsLike + deg);
+            Add("HighLow", obs.temperatureMax24Hour + "\u00B0 / " + obs.temperatureMin24Hour + "\u00B0");
+            Add("Change24h", (obs.temperatureChange24Hour > 0 ? "+" : string.Empty) + obs.temperatureChange24Hour + "\u00B0");
+            Add("DewPoint", obs.temperatureDewPoint + deg);
+            Add("HeatIndex", obs.temperatureHeatIndex + deg);
+            Add("WindChill", obs.temperatureWindChill + deg);
+            Add("Humidity", obs.relativeHumidity + "%");
+
+            var wind = (obs.windDirectionCardinal + " " + obs.windSpeed + " " + MeasureUnitUtils.GetWindSpeedUnits(units)).Trim();
+            if (obs.windGust.HasValue)
+                wind += ", gusts " + obs.windGust.Value;
+            Add("Wind", wind);
+
+            Add("UV", obs.uvIndex + (string.IsNullOrEmpty(obs.uvDescription) ? string.Empty : " (" + obs.uvDescription + ")"));
+
+            // Imperial: altimeter setting in inHg, as US forecasts show it. Otherwise sea-level pressure in mb.
+            var pressure = imperial ? Num(obs.pressureAltimeter) + " inHg" : Num(obs.pressureMeanSeaLevel) + " mb";
+            if (!string.IsNullOrEmpty(obs.pressureTendencyTrend))
+                pressure += ", " + obs.pressureTendencyTrend.ToLowerInvariant();
+            Add("Pressure", pressure);
+
+            Add("Visibility", Num(obs.visibility) + " " + MeasureUnitUtils.GetVisibilityUnits(units));
+            // The Open-Meteo backup sends BackupWeatherService.CeilingUnknown when no station tells the ceiling.
+            if (obs.cloudCeiling is >= 0)
+                Add("CloudCeiling", MeasureUnitUtils.CeilingInUnits(obs.cloudCeiling.Value, units).ToString("N0", c) + " " + MeasureUnitUtils.GetAltitudeUnits(units));
+            Add("Rain1h", Num(obs.precip1Hour) + " " + rain);
+            Add("Rain6h", Num(obs.precip6Hour) + " " + rain);
+            Add("Rain24h", Num(obs.precip24Hour) + " " + rain);
+            Add("Snow24h", Num(obs.snow24Hour) + " " + snow);
+            Add("Sunrise", await VariousUtils.GetTimeBasedOnUserSettings(obs.sunriseTimeLocal.DateTime));
+            Add("Sunset", await VariousUtils.GetTimeBasedOnUserSettings(obs.sunsetTimeLocal.DateTime));
+            Add("Observed", await VariousUtils.GetTimeBasedOnUserSettings(obs.validTimeLocal.DateTime));
+            return sb.ToString();
+        }
+
+        // The next moonrise or moonset that is still to come, for example "d.Moonrise=1:51 AM".
+        // A time on a later day starts with the weekday, for example "d.Moonset=Thu 2:38 PM".
+        // The forecast list can start with the day before, and a day can have no moonrise at all.
+        private static async Task<string> FormatMoonTimeAsync(string key, List<DateTimeOffset?>? times)
+        {
+            if (times == null)
+                return string.Empty;
+
+            var now = DateTimeOffset.UtcNow;
+            foreach (var entry in times)
+            {
+                if (entry is not DateTimeOffset time || time <= now)
+                    continue;
+
+                var text = await VariousUtils.GetTimeBasedOnUserSettings(time.DateTime);
+                if (time.Date != now.ToOffset(time.Offset).Date)
+                    text = time.ToString("ddd", CultureInfo.CurrentCulture) + " " + text;
+                return "d." + key + "=" + OneLine(text) + "\n";
+            }
+            return string.Empty;
+        }
+
+        // Reads the existing all-locations file, so a failed request can keep the last good data.
+        private static async Task<Dictionary<string, string>> ReadPreviousBlocksAsync()
+        {
+            var result = new Dictionary<string, string>(StringComparer.Ordinal);
+            try
+            {
+                var path = Path.Combine(ApplicationData.Current.LocalFolder.Path, AllFileName);
+                if (!File.Exists(path))
+                    return result;
+
+                string? id = null;
+                var block = new StringBuilder();
+                foreach (var line in await File.ReadAllLinesAsync(path, Encoding.UTF8))
+                {
+                    if (line.StartsWith('[') && line.EndsWith(']'))
+                    {
+                        if (id != null) result[id] = block.ToString();
+                        id = line.Substring(1, line.Length - 2);
+                        block.Clear().Append(line).Append('\n');
+                    }
+                    else if (id != null)
+                    {
+                        block.Append(line).Append('\n');
+                    }
+                }
+                if (id != null) result[id] = block.ToString();
+            }
+            catch (Exception)
+            {
+                // No previous data.
+            }
+            return result;
+        }
+
+        private static async Task WriteFileAsync(string fileName, string text)
+        {
+            await WriteLock.WaitAsync();
+            try
+            {
+                var folder = ApplicationData.Current.LocalFolder.Path;
+                var tmp = Path.Combine(folder, fileName + ".tmp");
+                var dst = Path.Combine(folder, fileName);
+
+                // Write to a temporary file first, so the tray helper never reads a half-written file.
+                await File.WriteAllTextAsync(tmp, text, new UTF8Encoding(false));
+                File.Move(tmp, dst, true);
+            }
+            finally
+            {
+                WriteLock.Release();
+            }
+        }
+
+        private static string OneLine(string? value)
+        {
+            return (value ?? string.Empty).Replace('\r', ' ').Replace('\n', ' ');
+        }
+    }
+}
diff --git a/FluentWeather/Services/WaterService.cs b/FluentWeather/Services/WaterService.cs
new file mode 100644
index 0000000000000000000000000000000000000000..cff20e19feca63b5245151e900296a3105892edc
--- /dev/null
+++ b/FluentWeather/Services/WaterService.cs
@@ -0,0 +1,483 @@
+using FluentWeather.Helpers;
+using FluentWeather.Models;
+using FluentWeather.Utils;
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Net.Http;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using System.Xml;
+using Windows.Storage;
+
+namespace FluentWeather.Services
+{
+    /// <summary>
+    /// Local build: the nearest water station with a current water temperature, for the "Nearby
+    /// water" card and the tray hover lines. Two free sources, no key:
+    ///
+    ///   NOAA NDBC (www.ndbc.noaa.gov): buoys and shore stations on the coasts and the Great Lakes,
+    ///   including the NOAA tide stations. Water temperature, and often wind, gusts, air temperature
+    ///   and wave height. One file holds the latest reading of every station. It is downloaded at
+    ///   most every 30 minutes. The station names are downloaded once a month.
+    ///
+    ///   USGS Water Data (api.waterdata.usgs.gov): rivers, some lakes and reservoirs. Water
+    ///   temperature only (parameter 00010). Station names are looked up once and kept.
+    ///
+    ///   Open-Meteo Marine (marine-api.open-meteo.com): the modeled sea surface temperature at the
+    ///   location, when no station is in range. Ocean points only.
+    ///
+    /// The nearest NDBC station within MaxDistanceKm is tried first. When it has no reading newer
+    /// than MaxAge, the nearest USGS station is tried. Null means no station, and the card hides.
+    /// Each location is looked up at most once every 30 minutes.
+    /// </summary>
+    public static class WaterService
+    {
+        public const double MaxDistanceKm = 50;
+        private static readonly TimeSpan MaxAge = TimeSpan.FromHours(6);
+        private static readonly TimeSpan CacheTime = TimeSpan.FromMinutes(30);
+        private static readonly TimeSpan EmptyCacheTime = TimeSpan.FromMinutes(5);
+        private static readonly TimeSpan StationListAge = TimeSpan.FromDays(30);
+
+        private const string NdbcStationsFile = "waterStationsNdbc";
+        private const string UsgsNamesFile = "waterStationNamesUsgs";
+
+        private static readonly HttpClient Ndbc = ApiUtils.CreateClient("https://www.ndbc.noaa.gov/");
+        private static readonly HttpClient Usgs = ApiUtils.CreateClient("https://api.waterdata.usgs.gov/");
+
+        private static readonly Dictionary<string, (DateTime FetchedUtc, WaterReading? Reading)> Cache = new();
+        private static readonly SemaphoreSlim Lock = new(1, 1);
+        private static WaterStationStore? _ndbcStations;
+        private static string[]? _ndbcLatest;
+        private static DateTime _ndbcLatestFetchedUtc;
+        private static WaterStationNameStore? _usgsNames;
+
+        // --- Settings ---
+
+        public const string CardSettingKey = "waterCardEnabled";
+        public const string TraySettingKey = "waterTrayEnabled";
+
+        public static async Task<bool> IsCardEnabledAsync() =>
+            await ApplicationData.Current.LocalSettings.ReadAsync<bool>(CardSettingKey);
+
+        public static async Task<bool> IsTrayEnabledAsync() =>
+            await ApplicationData.Current.LocalSettings.ReadAsync<bool>(TraySettingKey);
+
+        // --- Lookup ---
+
+        public static async Task<WaterReading?> GetNearestAsync(double latitude, double longitude)
+        {
+            var ci = CultureInfo.InvariantCulture;
+            var key = latitude.ToString("0.00", ci) + "," + longitude.ToString("0.00", ci);
+
+            await Lock.WaitAsync();
+            try
+            {
+                // No reading (no station, or a failed request, for example right after the PC wakes up)
+                // is tried again after EmptyCacheTime instead of CacheTime.
+                if (Cache.TryGetValue(key, out var cached) &&
+                    DateTime.UtcNow - cached.FetchedUtc < (cached.Reading == null ? EmptyCacheTime : CacheTime))
+                    return cached.Reading;
+
+                WaterReading? reading = null;
+                try
+                {
+                    reading = await FromNdbcAsync(latitude, longitude) ?? await FromUsgsAsync(latitude, longitude) ??
+                              await FromMarineModelAsync(latitude, longitude);
+                }
+                catch (Exception)
+                {
+                    // No reading. The card hides until the next try.
+                }
+
+                Cache[key] = (DateTime.UtcNow, reading);
+                return reading;
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        // --- NOAA NDBC ---
+
+        // One file with the latest observation of every NDBC station: buoys, coastal and Great
+        // Lakes stations, and the NOAA tide stations. About 100 KB. Columns, separated by spaces:
+        // STN LAT LON YYYY MM DD hh mm WDIR WSPD GST WVHT DPD APD MWD PRES PTDY ATMP WTMP DEWP VIS TIDE
+        // Times are UTC. Speeds are m/s. Temperatures are Celsius. "MM" means missing.
+        private const int ColWdir = 8, ColWspd = 9, ColGst = 10, ColWvht = 11, ColAtmp = 17, ColWtmp = 18;
+
+        private static async Task<WaterReading?> FromNdbcAsync(double latitude, double longitude)
+        {
+            var lines = await GetNdbcLatestAsync();
+            if (lines == null)
+                return null;
+
+            WaterReading? best = null;
+            foreach (var line in lines)
+            {
+                if (line.Length == 0 || line[0] == '#')
+                    continue;
+                var c = line.Split((char[]?) null, StringSplitOptions.RemoveEmptyEntries);
+                if (c.Length <= ColWtmp)
+                    continue;
+                if (!TryParse(c[1], out var lat) || !TryParse(c[2], out var lon) || !TryParse(c[ColWtmp], out var waterC))
+                    continue;
+
+                var distance = DistanceKm(latitude, longitude, lat, lon);
+                if (distance > MaxDistanceKm || (best != null && distance >= best.DistanceKm))
+                    continue;
+
+                if (!int.TryParse(c[3], out var y) || !int.TryParse(c[4], out var mo) || !int.TryParse(c[5], out var d) ||
+                    !int.TryParse(c[6], out var h) || !int.TryParse(c[7], out var mi))
+                    continue;
+                DateTimeOffset observed;
+                try
+                {
+                    observed = new DateTimeOffset(y, mo, d, h, mi, 0, TimeSpan.Zero);
+                }
+                catch (ArgumentOutOfRangeException)
+                {
+                    continue;
+                }
+                if (DateTimeOffset.UtcNow - observed > MaxAge)
+                    continue;
+
+                var reading = new WaterReading
+                {
+                    Source = WaterSource.NoaaNdbc,
+                    StationId = c[0].ToUpperInvariant(),
+                    DistanceKm = distance,
+                    WaterTemperatureC = waterC,
+                    ObservedUtc = observed
+                };
+                if (TryParse(c[ColWspd], out var speed))
+                {
+                    reading.WindSpeedKmh = speed * 3.6;
+                    if (TryParse(c[ColWdir], out var degrees))
+                        reading.WindDirection = Cardinal(degrees);
+                    if (TryParse(c[ColGst], out var gust))
+                        reading.WindGustKmh = gust * 3.6;
+                }
+                if (TryParse(c[ColAtmp], out var airC))
+                    reading.AirTemperatureC = airC;
+                if (TryParse(c[ColWvht], out var waves))
+                    reading.WaveHeightM = waves;
+                best = reading;
+            }
+
+            if (best != null)
+                best.StationName = await GetNdbcNameAsync(best.StationId);
+            return best;
+        }
+
+        private static async Task<string[]?> GetNdbcLatestAsync()
+        {
+            if (_ndbcLatest != null && DateTime.UtcNow - _ndbcLatestFetchedUtc < CacheTime)
+                return _ndbcLatest;
+
+            try
+            {
+                using var response = await ApiUtils.GetWithRetryAsync(Ndbc, "data/latest_obs/latest_obs.txt");
+                if (!response.IsSuccessStatusCode)
+                    return _ndbcLatest;
+                var text = await response.Content.ReadAsStringAsync();
+                _ndbcLatest = text.Split('\n');
+                _ndbcLatestFetchedUtc = DateTime.UtcNow;
+                return _ndbcLatest;
+            }
+            catch (Exception)
+            {
+                return _ndbcLatest;
+            }
+        }
+
+        // Station names come from the NDBC station list, about 270 KB, downloaded once a month.
+        private static async Task<string> GetNdbcNameAsync(string stationId)
+        {
+            var list = await GetNdbcStationsAsync();
+            var station = list?.FirstOrDefault(s => string.Equals(s.Id, stationId, StringComparison.OrdinalIgnoreCase));
+            return station != null && station.Name.Length > 0 ? station.Name : "NDBC " + stationId;
+        }
+
+        private static async Task<List<WaterStation>?> GetNdbcStationsAsync()
+        {
+            if (_ndbcStations != null && DateTime.UtcNow.Ticks - _ndbcStations.FetchedUtcTicks < StationListAge.Ticks)
+                return _ndbcStations.Stations;
+
+            try
+            {
+                _ndbcStations = await ApplicationData.Current.LocalFolder.ReadAsync<WaterStationStore>(NdbcStationsFile);
+            }
+            catch (Exception)
+            {
+                _ndbcStations = null;
+            }
+
+            if (_ndbcStations != null && DateTime.UtcNow.Ticks - _ndbcStations.FetchedUtcTicks < StationListAge.Ticks)
+                return _ndbcStations.Stations;
+
+            try
+            {
+                using var response = await ApiUtils.GetWithRetryAsync(Ndbc, "activestations.xml");
+                if (!response.IsSuccessStatusCode)
+                    return _ndbcStations?.Stations;
+
+                var store = new WaterStationStore { FetchedUtcTicks = DateTime.UtcNow.Ticks };
+                using (var stream = await response.Content.ReadAsStreamAsync())
+                using (var reader = XmlReader.Create(stream, new XmlReaderSettings { DtdProcessing = DtdProcessing.Ignore }))
+                {
+                    while (reader.Read())
+                    {
+                        if (reader.NodeType != XmlNodeType.Element || reader.Name != "station")
+                            continue;
+                        var id = reader.GetAttribute("id");
+                        if (string.IsNullOrEmpty(id))
+                            continue;
+                        store.Stations.Add(new WaterStation { Id = id.ToUpperInvariant(), Name = CleanName(reader.GetAttribute("name"), id) });
+                    }
+                }
+
+                if (store.Stations.Count == 0)
+                    return _ndbcStations?.Stations;
+
+                _ndbcStations = store;
+                try
+                {
+                    await ApplicationData.Current.LocalFolder.SaveAsync(NdbcStationsFile, store);
+                }
+                catch (Exception)
+                {
+                    // Kept in memory for this run.
+                }
+
+                return store.Stations;
+            }
+            catch (Exception)
+            {
+                return _ndbcStations?.Stations;
+            }
+        }
+
+        // NDBC names look like "Capistrano Beach Nearshore, CA (284)" or
+        // "9410665 - Los Angeles Pier J, CA". The number parts are dropped.
+        private static string CleanName(string? name, string id)
+        {
+            if (string.IsNullOrWhiteSpace(name))
+                return "NDBC " + id.ToUpperInvariant();
+            var n = name!.Trim();
+            var dash = n.IndexOf(" - ", StringComparison.Ordinal);
+            if (dash > 0 && n.Substring(0, dash).All(char.IsDigit))
+                n = n.Substring(dash + 3);
+            var paren = n.LastIndexOf(" (", StringComparison.Ordinal);
+            if (paren > 0 && n.EndsWith(")", StringComparison.Ordinal))
+                n = n.Substring(0, paren);
+            return n;
+        }
+
+        public static string Cardinal(double degrees)
+        {
+            string[] names = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"];
+            var index = (int) Math.Round(((degrees % 360) + 360) % 360 / 22.5) % 16;
+            return names[index];
+        }
+
+        // --- Open-Meteo Marine ---
+        // When no station is in range, the sea surface temperature of the Open-Meteo marine model at
+        // the location is used. It exists only for points on or near the ocean. It is a model value,
+        // so the card names the model, and the distance is 0.
+
+        private static async Task<WaterReading?> FromMarineModelAsync(double latitude, double longitude)
+        {
+            var marine = await OpenMeteoExtrasService.GetMarineAsync(latitude, longitude);
+            if (marine?.SeaTemperatureC == null)
+                return null;
+            return new WaterReading
+            {
+                Source = WaterSource.OpenMeteoMarine,
+                StationId = "",
+                StationName = "WaterMarineModel".GetLocalized(),
+                DistanceKm = 0,
+                WaterTemperatureC = marine.SeaTemperatureC.Value,
+                ObservedUtc = DateTimeOffset.UtcNow,
+                WaveHeightM = marine.WaveHeightM
+            };
+        }
+
+        // --- USGS ---
+
+        private static async Task<WaterReading?> FromUsgsAsync(double latitude, double longitude)
+        {
+            var ci = CultureInfo.InvariantCulture;
+            var dLat = MaxDistanceKm / 111.0;
+            var dLon = MaxDistanceKm / (111.0 * Math.Max(0.2, Math.Cos(latitude * Math.PI / 180)));
+            var bbox = (longitude - dLon).ToString("0.0000", ci) + "," + (latitude - dLat).ToString("0.0000", ci) + "," +
+                       (longitude + dLon).ToString("0.0000", ci) + "," + (latitude + dLat).ToString("0.0000", ci);
+
+            UsgsFeatureCollection? collection;
+            try
+            {
+                var url = "ogcapi/v0/collections/latest-continuous/items?f=json&parameter_code=00010&limit=100&bbox=" + bbox;
+                using var response = await ApiUtils.GetWithRetryAsync(Usgs, url);
+                if (!response.IsSuccessStatusCode)
+                    return null;
+                var json = await response.Content.ReadAsStringAsync();
+                collection = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.UsgsFeatureCollection);
+            }
+            catch (Exception)
+            {
+                return null;
+            }
+
+            if (collection?.Features == null)
+                return null;
+
+            var best = collection.Features
+                .Select(f =>
+                {
+                    var p = f.Properties;
+                    var g = f.Geometry?.Coordinates;
+                    if (p == null || g == null || g.Count < 2 || string.IsNullOrEmpty(p.MonitoringLocationId))
+                        return null;
+                    if (!TryParse(p.Value, out var value) || !DateTimeOffset.TryParse(p.Time, ci, DateTimeStyles.AdjustToUniversal, out var time))
+                        return null;
+                    if (DateTimeOffset.UtcNow - time > MaxAge)
+                        return null;
+                    if (p.UnitOfMeasure != null && p.UnitOfMeasure.StartsWith("degF", StringComparison.OrdinalIgnoreCase))
+                        value = (value - 32) * 5 / 9;
+                    return new WaterReading
+                    {
+                        Source = WaterSource.Usgs,
+                        StationId = p.MonitoringLocationId,
+                        DistanceKm = DistanceKm(latitude, longitude, g[1], g[0]),
+                        WaterTemperatureC = value,
+                        ObservedUtc = time
+                    };
+                })
+                .Where(r => r != null && r.DistanceKm <= MaxDistanceKm)
+                .OrderBy(r => r!.DistanceKm)
+                .FirstOrDefault();
+
+            if (best == null)
+                return null;
+
+            best.StationName = await GetUsgsNameAsync(best.StationId);
+            return best;
+        }
+
+        private static async Task<string> GetUsgsNameAsync(string monitoringLocationId)
+        {
+            if (_usgsNames == null)
+            {
+                try
+                {
+                    _usgsNames = await ApplicationData.Current.LocalFolder.ReadAsync<WaterStationNameStore>(UsgsNamesFile);
+                }
+                catch (Exception)
+                {
+                    // A new store below.
+                }
+                _usgsNames ??= new WaterStationNameStore();
+            }
+
+            var known = _usgsNames.Stations.FirstOrDefault(s => s.Id == monitoringLocationId);
+            if (known != null)
+                return known.Name;
+
+            var fallback = monitoringLocationId.Replace("USGS-", "USGS ");
+            try
+            {
+                var url = "ogcapi/v0/collections/monitoring-locations/items/" + monitoringLocationId + "?f=json";
+                using var response = await ApiUtils.GetWithRetryAsync(Usgs, url);
+                if (!response.IsSuccessStatusCode)
+                    return fallback;
+                var json = await response.Content.ReadAsStringAsync();
+                var name = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.UsgsFeature)?.Properties?.MonitoringLocationName;
+                if (string.IsNullOrWhiteSpace(name))
+                    return fallback;
+
+                _usgsNames.Stations.Add(new WaterStation { Id = monitoringLocationId, Name = name });
+                try
+                {
+                    await ApplicationData.Current.LocalFolder.SaveAsync(UsgsNamesFile, _usgsNames);
+                }
+                catch (Exception)
+                {
+                    // Kept in memory for this run.
+                }
+
+                return name;
+            }
+            catch (Exception)
+            {
+                return fallback;
+            }
+        }
+
+        // --- Helpers ---
+
+        private static DateTimeOffset? ParseNoaaTime(string? text)
+        {
+            if (DateTimeOffset.TryParseExact(text, "yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture,
+                    DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var time))
+                return time;
+            return null;
+        }
+
+        private static bool TryParse(string? text, out double value) =>
+            double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
+
+        public static double DistanceKm(double lat1, double lon1, double lat2, double lon2)
+        {
+            const double r = 6371.0;
+            var dLat = (lat2 - lat1) * Math.PI / 180;
+            var dLon = (lon2 - lon1) * Math.PI / 180;
+            var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
+                    Math.Cos(lat1 * Math.PI / 180) * Math.Cos(lat2 * Math.PI / 180) * Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
+            return 2 * r * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
+        }
+
+        /// <summary>"3 min ago", "2 h ago", for the card and the tooltip.</summary>
+        public static string AgeText(DateTimeOffset observedUtc)
+        {
+            var age = DateTimeOffset.UtcNow - observedUtc;
+            if (age < TimeSpan.FromMinutes(1))
+                return "WaterJustNow".GetLocalized();
+            if (age < TimeSpan.FromHours(1))
+                return string.Format(CultureInfo.CurrentCulture, "WaterMinutesAgo".GetLocalized(), (int) age.TotalMinutes);
+            return string.Format(CultureInfo.CurrentCulture, "WaterHoursAgo".GetLocalized(), Math.Round(age.TotalHours, 1));
+        }
+
+        public static string SourceName(WaterSource source) =>
+            source switch
+            {
+                WaterSource.NoaaNdbc => "NOAA NDBC",
+                WaterSource.Usgs => "USGS",
+                _ => "Open-Meteo Marine"
+            };
+
+        // --- Display units ---
+
+        public static int TemperatureFor(double celsius, WetUnits units) =>
+            (int) Math.Round(units == WetUnits.e ? celsius * 9 / 5 + 32 : celsius);
+
+        public static int WindFor(double kmh, WetUnits units) => units switch
+        {
+            WetUnits.e or WetUnits.h => (int) Math.Round(kmh / 1.609344),
+            WetUnits.s => (int) Math.Round(kmh / 3.6),
+            _ => (int) Math.Round(kmh)
+        };
+
+        public static string WaveHeightFor(double meters, WetUnits units) =>
+            units == WetUnits.e
+                ? (meters * 3.28084).ToString("0.#", CultureInfo.CurrentCulture) + " ft"
+                : meters.ToString("0.#", CultureInfo.CurrentCulture) + " m";
+
+        public static string DistanceFor(double km, WetUnits units) =>
+            units is WetUnits.e or WetUnits.h
+                ? (km / 1.609344).ToString("0.#", CultureInfo.CurrentCulture) + " mi"
+                : km.ToString("0.#", CultureInfo.CurrentCulture) + " km";
+    }
+}
