+
+        [JsonPropertyName("sea_surface_temperature")]
+        public double? SeaSurfaceTemperature { get; set; }
+    }
+
+    // --- api.open-meteo.com/v1/forecast, wind detail ---
+    public class WindDetailResponse
+    {
