+                    h.temperatureHeatIndex.Add(HeatIndex(temp, hum));
+                    h.temperatureWindChill.Add(WindChill(temp, WindMph(speed)));
+                    h.uvDescription.Add(UvText(uv));
+                    h.uvIndex.Add(uv);
