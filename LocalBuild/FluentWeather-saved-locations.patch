+                0 => day ? 32 : 31,
+                1 => day ? 34 : 33,
+                2 => day ? 30 : 29,
+                3 => 26,
+                4 => day ? 28 : 27,
+                45 or 48 => 20,
+                51 or 53 or 55 => 9,
+                56 or 57 => 8,
+                61 => 11,
+                63 or 65 => 12,
+                66 or 67 => 10,
+                71 => 14,
+                73 or 75 => 16,
+                77 => 13,
+                80 or 81 => day ? 39 : 45,
+                82 => 12,
+                85 => day ? 41 : 46,
+                86 => 16,
+                95 => day ? 37 : 47,
+                96 or 99 => 4,
+                _ => day ? 34 : 33
