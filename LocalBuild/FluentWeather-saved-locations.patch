+
+        [JsonPropertyName("temperature_2m_max_icon_seamless")]
+        public List<double?>? IconMax { get; set; }
+
+        [JsonPropertyName("temperature_2m_min_icon_seamless")]
+        public List<double?>? IconMin { get; set; }
