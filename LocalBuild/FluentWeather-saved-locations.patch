+        private async Task OpenRequestedAlertAsync()
+        {
+            if (!AlertService.OpenDetailsRequested || _shownAlerts.Count == 0)
+                return;
+            AlertService.OpenDetailsRequested = false;
+            _openAlertKey = _shownAlerts[0].Key;
+            await RenderAlertsAsync();
