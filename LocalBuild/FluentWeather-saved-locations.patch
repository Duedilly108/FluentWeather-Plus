+            // --- Days and day parts ---
+
+            // A 12-hour part: the day from 7:00 to 19:00, the night from 19:00 to 7:00.
+            private sealed class Part
+            {
+                public DateTime Start;
+                public bool Day;
+                public List<int> Hours = new();
+                public string Name = "";
+            }
+
+            private List<Part> Parts()
+            {
+                if (_parts != null)
+                    return _parts;
+                _parts = new List<Part>();
+                for (var d = 0; d < 16; d++)
+                {
+                    foreach (var day in new[] { true, false })
+                    {
+                        var start = _nowLocal.Date.AddDays(d).AddHours(day ? 7 : 19);
+                        var part = new Part { Start = start, Day = day };
+                        for (var i = 0; i < Count; i++)
+                        {
+                            var t = TimeAt(i);
+                            if (t >= start && t < start.AddHours(12))
+                                part.Hours.Add(i);
+                        }
+                        // Local build (v55): the names are in the language of the app. weather.com sends them that way too.
+                        part.Name = d switch
+                        {
+                            0 => day ? Loc.Get("OmToday", "Today") : Loc.Get("OmTonight", "Tonight"),
+                            1 => day ? Loc.Get("OmTomorrow", "Tomorrow") : Loc.Get("OmTomorrowNight", "Tomorrow night"),
+                            _ => day ? WeekdayName(start) : Loc.Format("OmWeekdayNight", "{0} night", WeekdayName(start))
+                        };
+                        _parts.Add(part);
+                    }
+                }
+                return _parts;
+            }
+
+            public V3WxForecastDaily Daily(int days)
