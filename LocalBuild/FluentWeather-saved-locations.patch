+                return new SavedLocation
+                {
+                    PlaceId = x.PlaceId,
+                    Name = x.Name,
+                    FullName = fullName,
+                    Label = label,
+                    ToolTipText = string.IsNullOrEmpty(shortcut) ? fullName : fullName + "\n" + shortcut,
+                    IsActive = x.PlaceId == _activePlaceId
