+                var wc = 35.74 + 0.6215 * t - 35.75 * Math.Pow(windMph, 0.16) + 0.4275 * t * Math.Pow(windMph, 0.16);
+                return (int) Math.Round(FromF(Math.Min(t, wc)));
+            }
