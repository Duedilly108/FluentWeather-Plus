+                          + Reading("PM2.5", data.Pm25) + Reading("PM10", data.Pm10)
+                          + Reading("AirQualityOzone".GetLocalized(), data.Ozone)
+                          + Reading("AirQualityNitrogenDioxide".GetLocalized(), data.NitrogenDioxide)
+                          + "\n\n" + "AirQualityCredit".GetLocalized();
