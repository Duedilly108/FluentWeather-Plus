+                var drop = new Image
+                {
+                    Width = 16,
+                    Stretch = Media.Stretch.Uniform,
+                    Margin = new Thickness(0, 0, 4, 0),
+                    Source = new Media.Imaging.SvgImageSource
+                    {
+                        UriSource = new Uri("ms-appx:///Assets/varicons/" + VariousUtils.GetPrecipIconChance(record.PrecipChance) + ".svg")
