+            public V2idxRunDaypartResult Run()
+            {
+                var (valid, local, ind, num, names) = IndexHeader();
+                var values = IndexParts().Select(p =>
+                {
+                    var a = Aggregate(p);
+                    var score = 10.0;
+                    score -= Math.Max(0, Math.Abs(a.TempF - 55) - 5) / 4;
