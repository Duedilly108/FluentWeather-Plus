+        private void CycleSavedLocation(int step)
+        {
+            var count = _savedLocations.Count;
+            if (count == 0)
+                return;
+
+            var current = -1;
+            for (var i = 0; i < count; i++)
+            {
+                if (_savedLocations[i].PlaceId == _activePlaceId)
+                {
+                    current = i;
+                    break;
+                }
+            }
+
+            var next = current < 0
+                ? (step > 0 ? 0 : count - 1)
+                : ((current + step) % count + count) % count;
