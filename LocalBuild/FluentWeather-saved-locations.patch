+                    if (a.TempF < 40) score++;
+                    if (a.Humidity > 70) score--;
+                    return Math.Max(0, Math.Min(10, score));
+                }).ToList();
+                return new V2idxDrySkinDaypartResult
+                {
+                    metadata = Meta(),
+                    DrySkinIndexDaypart = new DrySkinIndexDaypart
+                    {
