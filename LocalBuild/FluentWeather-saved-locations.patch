+
+namespace FluentWeather.Services
+{
+    /// <summary>The extra Open-Meteo data feeds. Each one has a main page chip and tray lines.</summary>
+    public enum ExtraFeed
+    {
+        Marine,
+        Wind,
+        Models,
+        River,
+        Pollen
+    }
+
+    /// <summary>
+    /// Local build: extra data from the free Open-Meteo APIs (open-meteo.com, CC BY 4.0, no key):
+    ///   Marine: waves, swell and sea surface temperature (marine-api.open-meteo.com), oceans worldwide.
+    ///   Wind: the highest gust of the next 6 hours, the model gust now, and the wind at 80 m.
+    ///   Models: today's high, low and precipitation from the ECMWF, GFS and ICON weather models.
+    ///   River: today's river discharge and the usual discharge for this day (flood-api.open-meteo.com).
+    ///   Pollen: the weather.com tree, grass and ragweed levels where weather.com has them (the US and
+    ///   some other countries), otherwise grains per cubic meter of six pollen types from Open-Meteo,
+    ///   Europe only (air-quality-api.open-meteo.com).
+    /// Each feed is requested only when the main page, the tray or the water card needs it. Each
+    /// location and feed is requested at most once an hour, because the values change hourly.
+    /// </summary>
+    public static class OpenMeteoExtrasService
+    {
+        private static readonly TimeSpan CacheTime = TimeSpan.FromMinutes(60);
+        private static readonly TimeSpan EmptyCacheTime = TimeSpan.FromMinutes(5);
+        private static readonly HttpClient Forecast = ApiUtils.CreateClient("https://api.open-meteo.com/");
+        private static readonly HttpClient Marine = ApiUtils.CreateClient("https://marine-api.open-meteo.com/");
+        private static readonly HttpClient Flood = ApiUtils.CreateClient("https://flood-api.open-meteo.com/");
+        private static readonly HttpClient AirQuality = ApiUtils.CreateClient("https://air-quality-api.open-meteo.com/");
+
+        private static readonly Dictionary<string, (DateTime FetchedUtc, object? Data)> Cache = new();
+        private static readonly SemaphoreSlim Lock = new(1, 1);
+
+        public static readonly ExtraFeed[] AllFeeds = [ExtraFeed.Marine, ExtraFeed.Wind, ExtraFeed.Models, ExtraFeed.River, ExtraFeed.Pollen];
+
+        // --- Settings: "extra.Marine.main", "extra.Marine.tray" and so on. All off by default. ---
+
+        public static string SettingKey(ExtraFeed feed, bool tray) => "extra." + feed + (tray ? ".tray" : ".main");
+
+        public static async Task<bool> IsOnAsync(ExtraFeed feed, bool tray) =>
+            await ApplicationData.Current.LocalSettings.ReadAsync<bool>(SettingKey(feed, tray));
+
+        public static async Task SetAsync(ExtraFeed feed, bool tray, bool on) =>
+            await ApplicationData.Current.LocalSettings.SaveAsync(SettingKey(feed, tray), on);
+
+        // --- weather.com pollen ---
+        // The weather requests of the main page and the tray already carry the weather.com pollen
+        // forecast. RememberWeatherComPollen keeps it by location for 3 hours, for the Pollen card.
+        private static readonly Dictionary<string, (DateTime StoredUtc, WeatherComPollen Pollen)> WeatherComPollenByPlace = new();
+        private static readonly TimeSpan WeatherComPollenAge = TimeSpan.FromHours(3);
+
+        private static string PlaceKey(double lat, double lon)
+        {
+            var ci = CultureInfo.InvariantCulture;
+            return lat.ToString("0.00", ci) + "," + lon.ToString("0.00", ci);
+        }
+
+        public static void RememberWeatherComPollen(double lat, double lon, WeatherComPollen? pollen)
+        {
+            if (pollen == null || !HasWeatherComPollen(pollen))
+                return;
+            lock (WeatherComPollenByPlace)
+                WeatherComPollenByPlace[PlaceKey(lat, lon)] = (DateTime.UtcNow, pollen);
+        }
+
+        /// <summary>The same data from the main request, which has its own model with fixed fields.</summary>
+        public static void RememberWeatherComPollen(double lat, double lon, PollenForecastDaypart? part)
+        {
+            if (part == null)
+                return;
+            RememberWeatherComPollen(lat, lon, new WeatherComPollen
+            {
+                daypartName = part.daypartName?.Select(x => (string?) x).ToList(),
+                treePollenIndex = part.treePollenIndex?.Select(x => (int?) x).ToList(),
+                treePollenCategory = part.treePollenCategory?.Select(x => (string?) x).ToList(),
+                grassPollenIndex = part.grassPollenIndex?.Select(x => (int?) x).ToList(),
+                grassPollenCategory = part.grassPollenCategory?.Select(x => (string?) x).ToList(),
+                ragweedPollenIndex = part.ragweedPollenIndex?.Select(x => (int?) x).ToList(),
+                ragweedPollenCategory = part.ragweedPollenCategory?.Select(x => (string?) x).ToList()
+            });
+        }
+
+        private static bool HasWeatherComPollen(WeatherComPollen p) =>
+            At(p.treePollenIndex, 0) != null || At(p.grassPollenIndex, 0) != null || At(p.ragweedPollenIndex, 0) != null;
+
+        private static WeatherComPollen? GetWeatherComPollen(double lat, double lon)
+        {
+            lock (WeatherComPollenByPlace)
+            {
+                if (WeatherComPollenByPlace.TryGetValue(PlaceKey(lat, lon), out var stored) &&
+                    DateTime.UtcNow - stored.StoredUtc < WeatherComPollenAge)
+                    return stored.Pollen;
+            }
+            return null;
+        }
+
+        private static T? At<T>(List<T?>? list, int index) where T : struct =>
+            list != null && index < list.Count ? list[index] : null;
+
+        private static string? AtText(List<string?>? list, int index) =>
+            list != null && index < list.Count ? list[index] : null;
+
+        // "Tree high, grass low, ragweed none" for one 12-hour part.
+        private static string WeatherComPart(WeatherComPollen p, int i)
+        {
+            var parts = new List<string>();
+            void Add(string nameKey, List<int?>? index, List<string?>? category)
+            {
+                var value = At(index, i);
+                if (value == null)
+                    return;
+                var text = AtText(category, i);
+                parts.Add(nameKey.GetLocalized() + " " + (string.IsNullOrEmpty(text) ? WeatherComLevel(value.Value) : text!.ToLower(CultureInfo.CurrentCulture)));
+            }
+            Add("PollenTree", p.treePollenIndex, p.treePollenCategory);
+            Add("PollenGrass", p.grassPollenIndex, p.grassPollenCategory);
+            Add("PollenRagweed", p.ragweedPollenIndex, p.ragweedPollenCategory);
+            return string.Join(", ", parts);
+        }
+
+        private static string WeatherComLevel(int index) =>
+            (index <= 0 ? "PollenNone" : index == 1 ? "PollenLow" : index == 2 ? "PollenModerate" : index == 3 ? "PollenHigh" : "PollenVeryHigh").GetLocalized();
+
+        private static (string Value, string Tip, string TrayLine)? DescribeWeatherComPollen(WeatherComPollen p)
+        {
+            // The card shows the type with the highest level now, or "None".
+            var now = new List<(string Name, int Index, string? Category)>
+            {
+                ("PollenTree".GetLocalized(), At(p.treePollenIndex, 0) ?? -1, AtText(p.treePollenCategory, 0)),
+                ("PollenGrass".GetLocalized(), At(p.grassPollenIndex, 0) ?? -1, AtText(p.grassPollenCategory, 0)),
+                ("PollenRagweed".GetLocalized(), At(p.ragweedPollenIndex, 0) ?? -1, AtText(p.ragweedPollenCategory, 0))
+            }.Where(x => x.Index >= 0).OrderByDescending(x => x.Index).ToList();
+            if (now.Count == 0)
+                return null;
+
+            var top = now[0];
+            var level = string.IsNullOrEmpty(top.Category) ? WeatherComLevel(top.Index) : top.Category!.ToLower(CultureInfo.CurrentCulture);
+            var value = top.Index <= 0 ? "PollenNone".GetLocalized() : top.Name + " " + level;
+
+            var tip = "ExtraPollenUsTip".GetLocalized();
+            for (var i = 0; i < 3; i++)
+            {
+                var line = WeatherComPart(p, i);
+                if (line.Length == 0)
+                    break;
+                var name = AtText(p.daypartName, i);
+                tip += "\n" + (string.IsNullOrEmpty(name) ? "" : name + ": ") + line;
+            }
+            tip += "\n\n" + "ExtraPollenUsCredit".GetLocalized();
+            return (value, tip, WeatherComPart(p, 0));
+        }
+
+        // --- Data ---
+
+        public static Task<MarineData?> GetMarineAsync(double lat, double lon) =>
+            GetCachedAsync(ExtraFeed.Marine, lat, lon, () => FetchMarineAsync(lat, lon));
+
+        public static Task<WindDetailData?> GetWindAsync(double lat, double lon) =>
+            GetCachedAsync(ExtraFeed.Wind, lat, lon, () => FetchWindAsync(lat, lon));
+
+        public static Task<List<ModelDay>?> GetModelsAsync(double lat, double lon) =>
+            GetCachedAsync(ExtraFeed.Models, lat, lon, () => FetchModelsAsync(lat, lon));
+
+        public static Task<RiverData?> GetRiverAsync(double lat, double lon) =>
+            GetCachedAsync(ExtraFeed.River, lat, lon, () => FetchRiverAsync(lat, lon));
+
+        public static Task<PollenData?> GetPollenAsync(double lat, double lon) =>
+            GetCachedAsync(ExtraFeed.Pollen, lat, lon, () => FetchPollenAsync(lat, lon));
+
+        private static async Task<T?> GetCachedAsync<T>(ExtraFeed feed, double lat, double lon, Func<Task<T?>> fetch) where T : class
+        {
+            var ci = CultureInfo.InvariantCulture;
+            var key = feed + "|" + lat.ToString("0.00", ci) + "," + lon.ToString("0.00", ci);
+
+            await Lock.WaitAsync();
+            try
+            {
+                // An empty result (no data, or a failed request, for example right after the PC wakes
+                // up) is tried again after EmptyCacheTime instead of CacheTime.
+                if (Cache.TryGetValue(key, out var cached) &&
+                    DateTime.UtcNow - cached.FetchedUtc < (cached.Data == null ? EmptyCacheTime : CacheTime))
+                    return cached.Data as T;
+            }
+            finally
+            {
+                Lock.Release();
+            }
+
+            T? data = null;
+            try
+            {
+                data = await fetch();
+            }
+            catch (Exception)
+            {
+                // No data. The chip hides until the next try.
+            }
+
+            await Lock.WaitAsync();
+            try
+            {
+                Cache[key] = (DateTime.UtcNow, data);
+            }
+            finally
+            {
+                Lock.Release();
+            }
+
+            return data;
+        }
+
+        private static string Point(double lat, double lon)
+        {
+            var ci = CultureInfo.InvariantCulture;
+            return "latitude=" + lat.ToString("0.0000", ci) + "&longitude=" + lon.ToString("0.0000", ci);
+        }
+
+        private static async Task<string?> GetJsonAsync(HttpClient client, string url)
+        {
+            using var response = await ApiUtils.GetWithRetryAsync(client, url);
+            if (!response.IsSuccessStatusCode)
+                return null;
+            return await response.Content.ReadAsStringAsync();
+        }
+
+        private static async Task<MarineData?> FetchMarineAsync(double lat, double lon)
+        {
+            var json = await GetJsonAsync(Marine, "v1/marine?" + Point(lat, lon) +
+                "&current=wave_height,wave_direction,wave_period,swell_wave_height,swell_wave_period,swell_wave_direction,sea_surface_temperature&timezone=auto");
+            if (json == null)
+                return null;
+            var c = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.MarineResponse)?.Current;
+            if (c == null || (c.WaveHeight == null && c.SeaSurfaceTemperature == null))
+                return null;
+            return new MarineData
+            {
+                WaveHeightM = c.WaveHeight,
+                WavePeriodS = c.WavePeriod,
+                WaveDirection = c.WaveDirection,
+                SwellHeightM = c.SwellHeight,
+                SwellPeriodS = c.SwellPeriod,
+                SwellDirection = c.SwellDirection,
+                SeaTemperatureC = c.SeaSurfaceTemperature
+            };
+        }
+
+        private static async Task<WindDetailData?> FetchWindAsync(double lat, double lon)
+        {
+            var json = await GetJsonAsync(Forecast, "v1/forecast?" + Point(lat, lon) +
+                "&current=wind_speed_10m,wind_gusts_10m,wind_direction_10m&hourly=wind_speed_80m,wind_gusts_10m&forecast_hours=6&timezone=auto");
+            if (json == null)
+                return null;
+            var r = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.WindDetailResponse);
+            if (r?.Current == null)
+                return null;
+            return new WindDetailData
+            {
+                SpeedKmh = r.Current.WindSpeed,
+                GustKmh = r.Current.WindGusts,
+                Direction = r.Current.WindDirection,
+                Speed80mKmh = r.Hourly?.WindSpeed80m?.FirstOrDefault(v => v != null),
+                MaxGustNext6hKmh = r.Hourly?.WindGusts?.Where(v => v != null).DefaultIfEmpty(null).Max()
+            };
+        }
+
+        private static async Task<List<ModelDay>?> FetchModelsAsync(double lat, double lon)
+        {
+            var json = await GetJsonAsync(Forecast, "v1/forecast?" + Point(lat, lon) +
+                "&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&models=ecmwf_ifs025,gfs_seamless,icon_seamless&forecast_days=1&timezone=auto");
+            if (json == null)
+                return null;
+            var d = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.ModelsResponse)?.Daily;
+            if (d == null)
+                return null;
+            static double? First(List<double?>? list) => list != null && list.Count > 0 ? list[0] : null;
+            var result = new List<ModelDay>
+            {
+                new() { Name = "ECMWF", MaxC = First(d.EcmwfMax), MinC = First(d.EcmwfMin), PrecipMm = First(d.EcmwfPrecip) },
+                new() { Name = "GFS", MaxC = First(d.GfsMax), MinC = First(d.GfsMin), PrecipMm = First(d.GfsPrecip) },
+                new() { Name = "ICON", MaxC = First(d.IconMax), MinC = First(d.IconMin), PrecipMm = First(d.IconPrecip) }
+            }.Where(m => m.MaxC != null && m.MinC != null).ToList();
+            return result.Count > 0 ? result : null;
+        }
+
+        private static async Task<RiverData?> FetchRiverAsync(double lat, double lon)
+        {
+            var json = await GetJsonAsync(Flood, "v1/flood?" + Point(lat, lon) +
+                "&daily=river_discharge,river_discharge_median&forecast_days=1");
+            if (json == null)
+                return null;
+            var d = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.FloodResponse)?.Daily;
+            var discharge = d?.Discharge?.FirstOrDefault();
+            if (discharge == null)
+                return null;
+            return new RiverData { DischargeM3s = discharge.Value, MedianM3s = d!.Median?.FirstOrDefault() };
+        }
+
+        private static async Task<PollenData?> FetchPollenAsync(double lat, double lon)
+        {
+            var json = await GetJsonAsync(AirQuality, "v1/air-quality?" + Point(lat, lon) +
+                "&current=alder_pollen,birch_pollen,grass_pollen,mugwort_pollen,olive_pollen,ragweed_pollen");
+            if (json == null)
+                return null;
+            var c = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.PollenResponse)?.Current;
+            if (c == null)
+                return null;
+            var all = new List<(string Name, double? Count)>
+            {
+                ("PollenAlder".GetLocalized(), c.Alder), ("PollenBirch".GetLocalized(), c.Birch),
+                ("PollenGrass".GetLocalized(), c.Grass), ("PollenMugwort".GetLocalized(), c.Mugwort),
+                ("PollenOlive".GetLocalized(), c.Olive), ("PollenRagweed".GetLocalized(), c.Ragweed)
+            };
+            if (all.All(p => p.Count == null))
+                return null; // outside Europe
+            var present = all.Where(p => p.Count != null).Select(p => (p.Name, p.Count!.Value)).OrderByDescending(p => p.Value).ToList();
+            return new PollenData { Highest = present[0].Name, HighestCount = present[0].Value, All = present.Where(p => p.Value > 0).ToList() };
+        }
+
+        // --- Text for the chips, tooltips and tray lines ---
+
+        public static string Degrees(WetUnits units) => "°" + MeasureUnitUtils.GetTemperatureUnits(units);
+
+        public static string Wind(double kmh, WetUnits units) =>
+            WaterService.WindFor(kmh, units) + " " + MeasureUnitUtils.GetWindSpeedUnits(units);
+
+        public static string Height(double meters, WetUnits units) => WaterService.WaveHeightFor(meters, units);
+
+        public static string Temperature(double celsius, WetUnits units) => WaterService.TemperatureFor(celsius, units) + Degrees(units);
+
+        public static string Direction(double? degrees) => degrees == null ? "" : " " + WaterService.Cardinal(degrees.Value);
+
+        public static string Period(double? seconds) =>
+            seconds == null ? "" : " " + string.Format(CultureInfo.CurrentCulture, "ExtraPeriod".GetLocalized(), Math.Round(seconds.Value));
+
+        public static string Discharge(double m3s, WetUnits units) =>
+            units == WetUnits.e
+                ? (m3s * 35.3147).ToString(m3s * 35.3147 < 10 ? "0.#" : "#,0", CultureInfo.CurrentCulture) + " ft³/s"
+                : m3s.ToString(m3s < 10 ? "0.##" : "#,0", CultureInfo.CurrentCulture) + " m³/s";
+
+        public static string PollenLevel(double count) =>
+            (count <= 0 ? "PollenNone" : count < 10 ? "PollenLow" : count < 50 ? "PollenModerate" : count < 200 ? "PollenHigh" : "PollenVeryHigh").GetLocalized();
+
+        /// <summary>The chip value, the tooltip and the tray line of a feed. Null when there is nothing to show.</summary>
+        public static async Task<(string Value, string Tip, string TrayLine)?> DescribeAsync(ExtraFeed feed, double lat, double lon, WetUnits units)
+        {
+            var credit = "\n\n" + "ExtraCredit".GetLocalized();
+            switch (feed)
+            {
+                case ExtraFeed.Marine:
+                {
+                    var m = await GetMarineAsync(lat, lon);
+                    if (m == null || (!m.HasWaves && m.SeaTemperatureC == null))
+                        return null;
+                    var value = m.HasWaves ? Height(m.WaveHeightM!.Value, units) + Period(m.WavePeriodS) : Temperature(m.SeaTemperatureC!.Value, units);
+                    var tip = "ExtraMarineTip".GetLocalized();
+                    if (m.HasWaves)
+                        tip += "\n" + "ExtraWaves".GetLocalized() + ": " + Height(m.WaveHeightM!.Value, units) + Period(m.WavePeriodS) + Direction(m.WaveDirection);
+                    if (m.SwellHeightM != null)
+                        tip += "\n" + "ExtraSwell".GetLocalized() + ": " + Height(m.SwellHeightM.Value, units) + Period(m.SwellPeriodS) + Direction(m.SwellDirection);
+                    if (m.SeaTemperatureC != null)
+                        tip += "\n" + "ExtraSeaTemp".GetLocalized() + ": " + Temperature(m.SeaTemperatureC.Value, units);
+                    var tray = value + (m.HasWaves && m.SeaTemperatureC != null ? ", " + "ExtraSeaShort".GetLocalized() + " " + Temperature(m.SeaTemperatureC.Value, units) : "");
+                    return (value, tip + credit, tray);
+                }
+                case ExtraFeed.Wind:
+                {
+                    // A forecast, not the current wind: the Wind card has the current wind from
+                    // weather.com, and the Nearby water card has the wind measured at the water.
+                    var w = await GetWindAsync(lat, lon);
+                    var peak = w?.MaxGustNext6hKmh ?? w?.GustKmh;
+                    if (w == null || peak == null)
+                        return null;
+                    var value = string.Format(CultureInfo.CurrentCulture, "ExtraWindForecastValue".GetLocalized(), Wind(peak.Value, units));
+                    var tip = "ExtraWindTip".GetLocalized();
+                    if (w.MaxGustNext6hKmh != null)
+                        tip += "\n" + "ExtraGusts6h".GetLocalized() + ": " + Wind(w.MaxGustNext6hKmh.Value, units);
+                    if (w.GustKmh != null)
+                        tip += "\n" + "ExtraGustsModelNow".GetLocalized() + ": " + Wind(w.GustKmh.Value, units);
+                    if (w.Speed80mKmh != null)
+                        tip += "\n" + "ExtraWind80m".GetLocalized() + ": " + Wind(w.Speed80mKmh.Value, units);
+                    tip += "\n" + "ExtraWindWhere".GetLocalized();
+                    var tray = value + (w.Speed80mKmh != null ? ", 80 m " + Wind(w.Speed80mKmh.Value, units) : "");
+                    return (value, tip + credit, tray);
+                }
+                case ExtraFeed.Models:
+                {
+                    var list = await GetModelsAsync(lat, lon);
+                    if (list == null)
+                        return null;
+                    string Day(ModelDay m) => m.Name + " " + WaterService.TemperatureFor(m.MaxC!.Value, units) + "° / " + WaterService.TemperatureFor(m.MinC!.Value, units) + "°";
+                    var highs = list.Select(m => WaterService.TemperatureFor(m.MaxC!.Value, units)).ToList();
+                    var value = highs.Min() == highs.Max() ? highs.Min() + Degrees(units) : highs.Min() + "-" + highs.Max() + Degrees(units);
+                    var tip = "ExtraModelsTip".GetLocalized();
+                    foreach (var m in list)
+                    {
+                        tip += "\n" + Day(m);
+                        if (m.PrecipMm != null)
+                        {
+                            var precip = HistoryUnits.PrecipFromMetric(m.PrecipMm, units == WetUnits.e ? "e" : "m");
+                            tip += ", " + precip!.Value.ToString("0.##", CultureInfo.CurrentCulture) + " " + MeasureUnitUtils.GetLiquidPrecipitationUnits(units);
+                        }
+                    }
+                    return (value, tip + credit, string.Join(", ", list.Select(Day)));
+                }
+                case ExtraFeed.River:
+                {
+                    var r = await GetRiverAsync(lat, lon);
+                    if (r == null)
+                        return null;
+                    var value = Discharge(r.DischargeM3s, units);
+                    var percent = r.MedianM3s is > 0 ? (int?) Math.Round(r.DischargeM3s / r.MedianM3s.Value * 100) : null;
+                    var tip = "ExtraRiverTip".GetLocalized() + "\n" + "ExtraRiverToday".GetLocalized() + ": " + value;
+                    if (r.MedianM3s != null)
+                        tip += "\n" + "ExtraRiverMedian".GetLocalized() + ": " + Discharge(r.MedianM3s.Value, units);
+                    if (percent != null)
+                        tip += "\n" + string.Format(CultureInfo.CurrentCulture, "ExtraRiverPercent".GetLocalized(), percent);
+                    var tray = value + (percent != null ? ", " + string.Format(CultureInfo.CurrentCulture, "ExtraRiverPercent".GetLocalized(), percent) : "");
+                    return (value, tip + credit, tray);
+                }
+                case ExtraFeed.Pollen:
+                {
+                    // weather.com first, where it has pollen. Open-Meteo in Europe otherwise.
+                    var us = GetWeatherComPollen(lat, lon);
+                    if (us != null)
+                    {
+                        var described = DescribeWeatherComPollen(us);
+                        if (described != null)
+                            return described;
+                    }
+
+                    var p = await GetPollenAsync(lat, lon);
+                    if (p == null)
+                        return null;
+                    var value = p.HighestCount <= 0 ? PollenLevel(0) : p.Highest + " " + PollenLevel(p.HighestCount);
+                    var tip = "ExtraPollenTip".GetLocalized();
+                    foreach (var (name, count) in p.All)
+                        tip += "\n" + name + ": " + Math.Round(count) + " (" + PollenLevel(count) + ")";
+                    if (p.All.Count == 0)
+                        tip += "\n" + PollenLevel(0);
+                    return (value, tip + credit, value);
+                }
+            }
+
+            return null;
+        }
+    }
+}
diff --git a/FluentWeather/Services/PastDaysService.cs b/FluentWeather/Services/PastDaysService.cs
new file mode 100644
index 0000000000000000000000000000000000000000..310dd345a0c5f073c3c03a8ef62bbea82ec27d53
--- /dev/null
+++ b/FluentWeather/Services/PastDaysService.cs
@@ -0,0 +1,544 @@
+using FluentWeather.Helpers;
+using FluentWeather.Models;
+using FluentWeather.Utils;
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+using System.Text.Json;
+using System.Threading;
+using System.Threading.Tasks;
+using Windows.Storage;
+
+namespace FluentWeather.Services
+{
+    /// <summary>
+    /// Records the high, the low and the conditions of each saved location, for the "Past days"
+    /// cards left of today.
+    ///
+    /// Two captures per saved location per day, each one small request (current conditions and
+    /// the 3-day forecast, the same request the tray icons use):
+    ///   the low capture, 60 minutes after the low that the hourly forecast predicts, and
+    ///   the high capture, 60 minutes after the predicted high.
+    /// The current conditions hold measured values: the lowest temperature of the last 24 hours
+    /// and the highest since 7 AM. So a capture that comes late still records the right values.
+    /// A background task checks every 15 minutes which captures are due. Data that the app or
+    /// the tray icons download anyway also updates the record, without an extra request.
+    ///
+    /// The records are kept in LocalFolder\pastDays.json for each saved location. The cards show
+    /// the two days before today. The history window (HistoryService) shows up to a year, so the
+    /// records are kept for 366 days.
+    /// </summary>
+    public static class PastDaysService
+    {
+        private const string FileName = "pastDays";
+        private const int CaptureDelayMinutes = 60;
+        private const int KeepDays = 2;
+        private const int RetainDays = 366;
+
+        private static readonly TimeSpan RetryAfterFailure = TimeSpan.FromHours(1);
+        private static readonly TimeSpan GapBetweenRequests = TimeSpan.FromSeconds(3);
+
+        private static readonly SemaphoreSlim Lock = new(1, 1);
+        private static readonly SemaphoreSlim RunLock = new(1, 1);
+
+        /// <summary>The recorded days before today, oldest first. Temperatures are in the given units.</summary>
+        public static async Task<List<PastDayRecord>> GetPastDaysAsync(string placeId, DateTimeOffset locationNow, string units)
+        {
+            var result = new List<PastDayRecord>();
+            if (string.IsNullOrEmpty(placeId))
+                return result;
+
+            PastDaysStore store;
+            await Lock.WaitAsync();
+            try
+            {
+                store = await LoadUnlockedAsync();
+            }
+            finally
+            {
+                Lock.Release();
+            }
+
+            for (var back = KeepDays; back >= 1; back--)
+            {
+                var date = DateKey(locationNow.AddDays(-back));
+                var record = store.Records.FirstOrDefault(r => r.PlaceId == placeId && r.Date == date);
+                if (record == null || (record.High == null && record.Low == null))
+                    continue;
+
+                result.Add(new PastDayRecord
+                {
+                    PlaceId = record.PlaceId,
+                    Date = record.Date,
+                    High = ConvertTemperature(record.High, record.Units, units),
+                    Low = ConvertTemperature(record.Low, record.Units, units),
+                    IconCode = DayIcon(record.IconCode),
+                    Phrase = record.Phrase,
+                    PrecipChance = record.PrecipChance,
+                    Units = units,
+                    LowCaptured = record.LowCaptured,
+                    HighCaptured = record.HighCaptured
+                });
+            }
+
+            return result;
+        }
+
+        /// <summary>
+        /// The recorded days of a location between two dates (yyyy-MM-dd, both included), by date,
+        /// converted to the given units. For the history window.
+        /// </summary>
+        public static async Task<Dictionary<string, PastDayRecord>> GetRecordedDaysAsync(string placeId, string fromDate, string toDate, string units)
+        {
+            var result = new Dictionary<string, PastDayRecord>();
+            if (string.IsNullOrEmpty(placeId))
+                return result;
+
+            PastDaysStore store;
+            await Lock.WaitAsync();
+            try
+            {
+                store = await LoadUnlockedAsync();
+            }
+            finally
+            {
+                Lock.Release();
+            }
+
+            foreach (var record in store.Records)
+            {
+                if (record.PlaceId != placeId ||
+                    string.CompareOrdinal(record.Date, fromDate) < 0 ||
+                    string.CompareOrdinal(record.Date, toDate) > 0)
+                    continue;
+
+                result[record.Date] = new PastDayRecord
+                {
+                    PlaceId = record.PlaceId,
+                    Date = record.Date,
+                    High = ConvertTemperature(record.High, record.Units, units),
+                    Low = ConvertTemperature(record.Low, record.Units, units),
+                    IconCode = DayIcon(record.IconCode),
+                    Phrase = record.Phrase,
+                    PrecipChance = record.PrecipChance,
+                    Precip = HistoryUnits.ConvertPrecip(record.Precip, record.Units, units),
+                    Snow = HistoryUnits.ConvertSnow(record.Snow, record.Units, units),
+                    WindMax = HistoryUnits.ConvertWind(record.WindMax, record.Units, units),
+                    GustMax = HistoryUnits.ConvertWind(record.GustMax, record.Units, units),
+                    Units = units,
+                    LowCaptured = record.LowCaptured,
+                    HighCaptured = record.HighCaptured
+                };
+            }
+
+            return result;
+        }
+
+        /// <summary>Remembers the coordinates of a saved location, for the history archive.</summary>
+        public static async Task SetCoordinatesAsync(string placeId, double latitude, double longitude)
+        {
+            if (string.IsNullOrEmpty(placeId))
+                return;
+
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                var schedule = GetOrAddSchedule(store, placeId);
+                if (schedule.HasCoordinates && Math.Abs(schedule.Latitude - latitude) < 0.0001 && Math.Abs(schedule.Longitude - longitude) < 0.0001)
+                    return;
+
+                schedule.Latitude = latitude;
+                schedule.Longitude = longitude;
+                schedule.HasCoordinates = true;
+                await SaveUnlockedAsync(store);
+            }
+            catch (Exception)
+            {
+                // The history window then shows recorded days only.
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        /// <summary>The current time at a location, from its last known UTC offset, or the PC time.</summary>
+        public static async Task<DateTimeOffset> GetLocationNowAsync(string placeId)
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                var schedule = store.Schedules.FirstOrDefault(s => s.PlaceId == placeId);
+                if (schedule is { OffsetKnown: true })
+                    return DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromMinutes(schedule.UtcOffsetMinutes));
+                return DateTimeOffset.Now;
+            }
+            catch (Exception)
+            {
+                return DateTimeOffset.Now;
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        public static async Task<(double Latitude, double Longitude)?> GetCoordinatesAsync(string placeId)
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                var schedule = store.Schedules.FirstOrDefault(s => s.PlaceId == placeId);
+                if (schedule is { HasCoordinates: true })
+                    return (schedule.Latitude, schedule.Longitude);
+                return null;
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        /// <summary>
+        /// Sets the capture times of a location from its hourly forecast: the hours of the lowest and
+        /// the highest temperature in the next 24 hours.
+        /// </summary>
+        public static async Task UpdateScheduleAsync(string placeId, V3WxForecastHourly? hourly, TimeSpan utcOffset)
+        {
+            if (hourly == null || string.IsNullOrEmpty(placeId))
+                return;
+
+            var count = Math.Min(24, Math.Min(hourly.temperature.Count, hourly.validTimeLocal.Count));
+            if (count < 6)
+                return;
+
+            int lowIndex = 0, highIndex = 0;
+            for (var i = 1; i < count; i++)
+            {
+                if (hourly.temperature[i] < hourly.temperature[lowIndex]) lowIndex = i;
+                if (hourly.temperature[i] > hourly.temperature[highIndex]) highIndex = i;
+            }
+
+            var low = hourly.validTimeLocal[lowIndex];
+            var high = hourly.validTimeLocal[highIndex];
+
+            // The low capture needs the night behind it, and the high capture needs the
+            // "since 7 AM" value. Both captures stay before midnight.
+            var lowMinutes = Math.Clamp(low.Hour * 60 + low.Minute, 4 * 60, 22 * 60);
+            var highMinutes = Math.Clamp(high.Hour * 60 + high.Minute, 9 * 60, 22 * 60);
+
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                var schedule = GetOrAddSchedule(store, placeId);
+                if (schedule.LowMinutes == lowMinutes && schedule.HighMinutes == highMinutes &&
+                    schedule.OffsetKnown && schedule.UtcOffsetMinutes == (int) utcOffset.TotalMinutes)
+                    return;
+
+                schedule.LowMinutes = lowMinutes;
+                schedule.HighMinutes = highMinutes;
+                schedule.UtcOffsetMinutes = (int) utcOffset.TotalMinutes;
+                schedule.OffsetKnown = true;
+                await SaveUnlockedAsync(store);
+            }
+            catch (Exception)
+            {
+                // The default capture times stay.
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        /// <summary>
+        /// Updates today's record of a saved location from data that was downloaded anyway, or from a
+        /// capture. Only a capture marks the low or the high as final.
+        /// </summary>
+        public static async Task ObserveAsync(string placeId, V3WxObservationsCurrent? observation,
+            IReadOnlyList<int?>? iconCodes, IReadOnlyList<string?>? phrases, IReadOnlyList<int?>? precipChances,
+            string units, bool lowCapture = false, bool highCapture = false)
+        {
+            if (observation == null || string.IsNullOrEmpty(placeId))
+                return;
+
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                var local = observation.validTimeLocal;
+                var date = DateKey(local);
+
+                var record = store.Records.FirstOrDefault(r => r.PlaceId == placeId && r.Date == date);
+                if (record == null)
+                {
+                    record = new PastDayRecord { PlaceId = placeId, Date = date, Units = units };
+                    store.Records.Add(record);
+                }
+
+                var before = Fingerprint(record);
+
+                if (record.Units != units)
+                {
+                    record.High = ConvertTemperature(record.High, record.Units, units);
+                    record.Low = ConvertTemperature(record.Low, record.Units, units);
+                    record.Precip = HistoryUnits.ConvertPrecip(record.Precip, record.Units, units);
+                    record.Snow = HistoryUnits.ConvertSnow(record.Snow, record.Units, units);
+                    record.WindMax = HistoryUnits.ConvertWind(record.WindMax, record.Units, units);
+                    record.GustMax = HistoryUnits.ConvertWind(record.GustMax, record.Units, units);
+                    record.Units = units;
+                }
+
+                // The totals of the day, for the history window. The 24-hour totals grow through the
+                // day, so the largest value seen is kept. The wind is the highest speed seen.
+                if (local.Hour >= 4)
+                {
+                    record.Precip = record.Precip == null ? observation.precip24Hour : Math.Max(record.Precip.Value, observation.precip24Hour);
+                    record.Snow = record.Snow == null ? observation.snow24Hour : Math.Max(record.Snow.Value, observation.snow24Hour);
+                }
+                record.WindMax = record.WindMax == null ? observation.windSpeed : Math.Max(record.WindMax.Value, observation.windSpeed);
+                if (observation.windGust != null)
+                    record.GustMax = record.GustMax == null ? observation.windGust : Math.Max(record.GustMax.Value, observation.windGust.Value);
+
+                // The highest temperature since 7 AM belongs to today only after 7 AM.
+                if (local.Hour >= 8)
+                {
+                    record.High = record.High == null
+                        ? observation.temperatureMaxSince7Am
+                        : Math.Max(record.High.Value, observation.temperatureMaxSince7Am);
+                    if (highCapture)
+                        record.HighCaptured = true;
+                }
+
+                // The lowest temperature of the last 24 hours includes the night. It is updated until
+                // the low capture makes it final.
+                if (local.Hour >= 4 && !record.LowCaptured)
+                {
+                    record.Low = observation.temperatureMin24Hour;
+                    if (lowCapture)
+                        record.LowCaptured = true;
+                }
+
+                // The conditions of the day: the day part of the forecast, or the night part when the
+                // day part has passed and nothing was recorded yet.
+                var dayIcon = iconCodes is { Count: > 0 } ? iconCodes[0] : null;
+                if (dayIcon != null)
+                {
+                    record.IconCode = dayIcon;
+                    record.Phrase = phrases is { Count: > 0 } ? phrases[0] : record.Phrase;
+                    record.PrecipChance = precipChances is { Count: > 0 } ? precipChances[0] : record.PrecipChance;
+                }
+                else if (record.IconCode == null && iconCodes is { Count: > 1 })
+                {
+                    record.IconCode = DayIcon(iconCodes[1]);
+                    record.Phrase = phrases is { Count: > 1 } ? phrases[1] : null;
+                    record.PrecipChance = precipChances is { Count: > 1 } ? precipChances[1] : null;
+                }
+
+                var schedule = GetOrAddSchedule(store, placeId);
+                var offsetChanged = !schedule.OffsetKnown || schedule.UtcOffsetMinutes != (int) local.Offset.TotalMinutes;
+                schedule.UtcOffsetMinutes = (int) local.Offset.TotalMinutes;
+                schedule.OffsetKnown = true;
+                if (lowCapture || highCapture)
+                    schedule.LastFailedUtcTicks = 0;
+
+                // Keep a year of days for the history window.
+                var oldest = DateKey(local.AddDays(-RetainDays));
+                var removed = store.Records.RemoveAll(r => r.PlaceId == placeId && string.CompareOrdinal(r.Date, oldest) < 0);
+
+                if (before != Fingerprint(record) || offsetChanged || removed > 0 || lowCapture || highCapture)
+                    await SaveUnlockedAsync(store);
+            }
+            catch (Exception)
+            {
+                // A failed record only means a missing past day later.
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        /// <summary>
+        /// Downloads the captures that are due for the saved locations, one location at a time with a
+        /// short gap between requests. Called by the background task every 15 minutes and when the
+        /// app shows new data.
+        /// </summary>
+        public static async Task RunDueCapturesAsync()
+        {
+            if (!await RunLock.WaitAsync(0))
+                return; // a run is already going
+
+            try
+            {
+                var saved = await SavedLocationsService.GetAllAsync();
+                var savedIds = new HashSet<string>(saved.Select(s => s.PlaceId));
+                var units = (await VariousUtils.GetUnitsCode()).ToString();
+
+                PastDaysStore store;
+                await Lock.WaitAsync();
+                try
+                {
+                    store = await LoadUnlockedAsync();
+                    var changed = false;
+                    if (store.SpreadMinutes < 0)
+                    {
+                        store.SpreadMinutes = Random.Shared.Next(0, 21);
+                        changed = true;
+                    }
+
+                    // Locations that are no longer saved are not kept.
+                    changed |= store.Records.RemoveAll(r => !savedIds.Contains(r.PlaceId)) > 0;
+                    changed |= store.Schedules.RemoveAll(s => !savedIds.Contains(s.PlaceId)) > 0;
+                    if (changed)
+                        await SaveUnlockedAsync(store);
+                }
+                finally
+                {
+                    Lock.Release();
+                }
+
+                var requests = 0;
+                foreach (var location in saved)
+                {
+                    var schedule = store.Schedules.FirstOrDefault(s => s.PlaceId == location.PlaceId)
+                                   ?? new PastDaySchedule { PlaceId = location.PlaceId };
+                    var nowUtc = DateTimeOffset.UtcNow;
+
+                    if (schedule.LastFailedUtcTicks > 0 && nowUtc.UtcTicks - schedule.LastFailedUtcTicks < RetryAfterFailure.Ticks)
+                        continue;
+
+                    var local = schedule.OffsetKnown
+                        ? nowUtc.ToOffset(TimeSpan.FromMinutes(schedule.UtcOffsetMinutes))
+                        : DateTimeOffset.Now;
+                    var date = DateKey(local);
+                    var record = store.Records.FirstOrDefault(r => r.PlaceId == location.PlaceId && r.Date == date);
+                    var minutes = local.Hour * 60 + local.Minute;
+                    var wait = CaptureDelayMinutes + store.SpreadMinutes;
+
+                    var lowDue = record is not { LowCaptured: true } && minutes >= schedule.LowMinutes + wait;
+                    var highDue = record is not { HighCaptured: true } && minutes >= schedule.HighMinutes + wait;
+                    if (!lowDue && !highDue)
+                        continue;
+
+                    if (requests > 0)
+                        await Task.Delay(GapBetweenRequests);
+                    requests++;
+
+                    try
+                    {
+                        using var response = await ApiUtils.GetCurrentConditions(location.PlaceId);
+                        var json = await response.Content.ReadAsStringAsync();
+                        var data = JsonSerializer.Deserialize(json, FluentWeatherJsonContext.Default.CurrentConditionsResponse);
+                        var observation = data?.v3wxobservationscurrent;
+                        if (observation == null)
+                            throw new InvalidOperationException("No current conditions.");
+
+                        var part = data?.v3wxforecastdaily3day?.daypart?.FirstOrDefault();
+                        await ObserveAsync(location.PlaceId, observation, part?.iconCode, part?.wxPhraseLong, part?.precipChance,
+                            units, lowDue, highDue);
+                    }
+                    catch (Exception)
+                    {
+                        await MarkFailedAsync(location.PlaceId);
+                    }
+                }
+            }
+            catch (Exception)
+            {
+                // The next run tries again.
+            }
+            finally
+            {
+                RunLock.Release();
+            }
+        }
+
+        private static async Task MarkFailedAsync(string placeId)
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                var store = await LoadUnlockedAsync();
+                GetOrAddSchedule(store, placeId).LastFailedUtcTicks = DateTimeOffset.UtcNow.UtcTicks;
+                await SaveUnlockedAsync(store);
+            }
+            catch (Exception)
+            {
+                // The next run tries again.
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        private static PastDaySchedule GetOrAddSchedule(PastDaysStore store, string placeId)
+        {
+            var schedule = store.Schedules.FirstOrDefault(s => s.PlaceId == placeId);
+            if (schedule == null)
+            {
+                schedule = new PastDaySchedule { PlaceId = placeId };
+                store.Schedules.Add(schedule);
+            }
+
+            return schedule;
+        }
+
+        private static string DateKey(DateTimeOffset local) => local.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
+
+        private static string Fingerprint(PastDayRecord r) =>
+            r.High + "|" + r.Low + "|" + r.IconCode + "|" + r.Phrase + "|" + r.PrecipChance + "|" + r.Units + "|" + r.LowCaptured + "|" + r.HighCaptured +
+            "|" + r.Precip + "|" + r.Snow + "|" + r.WindMax + "|" + r.GustMax;
+
+        /// <summary>
+        /// The day version of a weather.com night icon code. A day that was first recorded in the
+        /// evening only has the night forecast, and a past day card shows the day.
+        /// </summary>
+        public static int? DayIcon(int? code) => code switch
+        {
+            27 => 28, // mostly cloudy
+            29 => 30, // partly cloudy
+            31 => 32, // clear
+            33 => 34, // fair
+            45 => 39, // scattered showers
+            46 => 41, // scattered snow showers
+            47 => 38, // scattered thunderstorms
+            _ => code
+        };
+
+        private static bool IsFahrenheit(string units) => units == "e";
+
+        public static int? ConvertTemperature(int? value, string from, string to)
+        {
+            if (value == null || IsFahrenheit(from) == IsFahrenheit(to))
+                return value;
+
+            return IsFahrenheit(from)
+                ? (int) Math.Round((value.Value - 32) * 5 / 9.0)
+                : (int) Math.Round(value.Value * 9 / 5.0 + 32);
+        }
+
+        private static async Task<PastDaysStore> LoadUnlockedAsync()
+        {
+            try
+            {
+                return await ApplicationData.Current.LocalFolder.ReadAsync<PastDaysStore>(FileName) ?? new PastDaysStore();
+            }
+            catch (Exception)
+            {
+                return new PastDaysStore();
+            }
+        }
+
+        private static async Task SaveUnlockedAsync(PastDaysStore store)
+        {
+            await ApplicationData.Current.LocalFolder.SaveAsync(FileName, store);
+        }
+    }
+}
diff --git a/FluentWeather/Services/SavedLocationsService.cs b/FluentWeather/Services/SavedLocationsService.cs
new file mode 100644
index 0000000000000000000000000000000000000000..8255c5af70435a2d96500b95fbb7fa14a6dc00ce
--- /dev/null
+++ b/FluentWeather/Services/SavedLocationsService.cs
@@ -0,0 +1,165 @@
+using FluentWeather.Helpers;
+using FluentWeather.Models;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+using Windows.Storage;
+
+namespace FluentWeather.Services
+{
+    /// <summary>
+    /// Stores the list of pinned locations in LocalFolder\savedLocations.json.
+    /// A file is used instead of LocalSettings because LocalSettings values are limited to 8 KB.
+    /// The active location is still stored in the "lastPlaceId" setting, so the live tile
+    /// background task and the first-run dialog keep working unchanged.
+    /// </summary>
+    public static class SavedLocationsService
+    {
+        public const int MaxLocations = 25;
+
+        private const string FileName = "savedLocations";
+
+        private static readonly SemaphoreSlim Lock = new(1, 1);
+
+        private static List<SavedLocation>? _cache;
+
+        public static async Task<IReadOnlyList<SavedLocation>> GetAllAsync()
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                return Snapshot(await LoadUnlockedAsync());
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        public static async Task<bool> ContainsAsync(string placeId)
+        {
+            var all = await GetAllAsync();
+            return all.Any(x => x.PlaceId == placeId);
+        }
+
+        /// <summary>Adds a location. Returns false if the list is full. Adding an existing location updates its names.</summary>
+        public static async Task<bool> AddAsync(string placeId, string name, string fullName)
+        {
+            if (string.IsNullOrWhiteSpace(placeId))
+                return false;
+
+            await Lock.WaitAsync();
+            try
+            {
+                var list = await LoadUnlockedAsync();
+                var existing = list.FirstOrDefault(x => x.PlaceId == placeId);
+
+                if (existing != null)
+                {
+                    existing.Name = name;
+                    existing.FullName = fullName;
+                }
+                else
+                {
+                    if (list.Count >= MaxLocations)
+                        return false;
+
+                    list.Add(new SavedLocation { PlaceId = placeId, Name = name, FullName = fullName });
+                }
+
+                await SaveUnlockedAsync(list);
+                return true;
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        public static async Task RemoveAsync(string placeId)
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                var list = await LoadUnlockedAsync();
+                if (list.RemoveAll(x => x.PlaceId == placeId) > 0)
+                    await SaveUnlockedAsync(list);
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        /// <summary>Moves a location by <paramref name="offset"/> positions. Negative values move it left.</summary>
+        public static async Task MoveAsync(string placeId, int offset)
+        {
+            await Lock.WaitAsync();
+            try
+            {
+                var list = await LoadUnlockedAsync();
+                var index = list.FindIndex(x => x.PlaceId == placeId);
+                if (index < 0)
+                    return;
+
+                var newIndex = Math.Clamp(index + offset, 0, list.Count - 1);
+                if (newIndex == index)
+                    return;
+
+                var item = list[index];
+                list.RemoveAt(index);
+                list.Insert(newIndex, item);
+                await SaveUnlockedAsync(list);
+            }
+            finally
+            {
+                Lock.Release();
+            }
+        }
+
+        private static async Task<List<SavedLocation>> LoadUnlockedAsync()
+        {
+            if (_cache != null)
+                return _cache;
+
+            try
+            {
+                _cache = await ApplicationData.Current.LocalFolder.ReadAsync<List<SavedLocation>>(FileName) ?? [];
+            }
+            catch (Exception)
+            {
+                // A missing or corrupt file must not stop the app from starting.
+                _cache = [];
+            }
+
+            // Drop invalid or duplicate entries that may come from a hand-edited file.
+            _cache = _cache
+                .Where(x => x != null && !string.IsNullOrWhiteSpace(x.PlaceId))
+                .GroupBy(x => x.PlaceId)
+                .Select(g => g.First())
+                .Take(MaxLocations)
+                .ToList();
+
+            return _cache;
+        }
+
+        private static async Task SaveUnlockedAsync(List<SavedLocation> list)
+        {
+            _cache = list;
+            await ApplicationData.Current.LocalFolder.SaveAsync(FileName, list);
+        }
+
+        private static IReadOnlyList<SavedLocation> Snapshot(List<SavedLocation> list)
+        {
+            // Return copies so the UI can set Label and IsActive without touching the stored objects.
+            return list.Select(x => new SavedLocation
+            {
+                PlaceId = x.PlaceId,
+                Name = x.Name,
+                FullName = x.FullName
+            }).ToList();
+        }
+    }
+}
