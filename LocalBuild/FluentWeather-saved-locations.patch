+                    return (int) Math.Max(1, Math.Min(10, Math.Round(score)));
+                }).ToList();
+                var categories = values.Select(v => v >= 9 ? Loc.Get("OmRunExcellent", "Excellent") : v >= 7 ? Loc.Get("OmRunGood", "Good")
