+        // --- K: hourly chart ---
+
+        private async Task UpdateHourlyChartAsync(MoreContext context, string placeId)
+        {
+            try
+            {
+                _hourlyChartOn = await MoreDataService.IsOnAsync(MoreItem.Hourly, false);
